# Resend API Key — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email to receive quote/contact notifications
NOTIFY_EMAIL=info@vidaacessivel.pt

# Keystatic CMS secret (any random string — required to access /keystatic/ admin)
KEYSTATIC_SECRET=your-secret-here

# GitHub OAuth for Keystatic (create at github.com/settings/apps)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
