---
export interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Receba o nosso catálogo gratuito',
  subheading = 'Toda a informação sobre equipamentos, preços e apoios do Estado numa brochura completa.',
} = Astro.props;
---

<section class="rounded-2xl border border-border bg-secondary p-6 md:p-8" aria-labelledby="catalog-form-heading">
  {heading && (
    <h2 id="catalog-form-heading" class="font-heading text-xl font-bold text-foreground mb-1">
      {heading}
    </h2>
  )}
  {subheading && (
    <p class="font-body text-sm text-muted-foreground mb-6">{subheading}</p>
  )}

  <!-- Success state -->
  <div id="catalog-success" class="hidden rounded-xl bg-primary/10 border border-primary/20 p-6 text-center" role="alert" aria-live="polite">
    <svg class="mx-auto mb-3 h-10 w-10 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="font-heading font-bold text-foreground text-lg mb-1">Catálogo enviado!</p>
    <p class="font-body text-sm text-muted-foreground">Verifique a sua caixa de email. Se não receber, confirme a pasta de spam.</p>
  </div>

  <!-- Error state -->
  <div id="catalog-error" class="hidden rounded-xl bg-destructive/10 border border-destructive/20 p-4 mb-4" role="alert" aria-live="polite">
    <p class="font-body text-sm text-destructive font-medium">
      Ocorreu um erro ao processar o seu pedido. Por favor tente novamente.
    </p>
  </div>

  <form id="catalog-form" novalidate aria-label="Formulário de pedido de catálogo">
    <div class="grid gap-4 sm:grid-cols-2">

      <!-- Nome -->
      <div class="flex flex-col gap-1.5">
        <label for="catalog-nome" class="font-body text-sm font-medium text-foreground">
          Nome <span class="text-destructive" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="catalog-nome"
          name="nome"
          required
          autocomplete="name"
          placeholder="O seu nome"
          class="rounded-xl border border-input bg-background px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition"
          aria-required="true"
        />
        <span class="hidden text-xs text-destructive" id="catalog-nome-error" role="alert">Nome é obrigatório.</span>
      </div>

      <!-- Email -->
      <div class="flex flex-col gap-1.5">
        <label for="catalog-email" class="font-body text-sm font-medium text-foreground">
          Email <span class="text-destructive" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="catalog-email"
          name="email"
          required
          autocomplete="email"
          placeholder="email@exemplo.pt"
          class="rounded-xl border border-input bg-background px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition"
          aria-required="true"
        />
        <span class="hidden text-xs text-destructive" id="catalog-email-error" role="alert">Email válido é obrigatório.</span>
      </div>
    </div>

    <!-- GDPR checkbox -->
    <div class="mt-4 flex items-start gap-3">
      <input
        type="checkbox"
        id="catalog-gdpr"
        name="gdpr"
        required
        class="mt-0.5 h-4 w-4 rounded border-input accent-primary cursor-pointer"
        aria-required="true"
        aria-describedby="catalog-gdpr-label"
      />
      <label id="catalog-gdpr-label" for="catalog-gdpr" class="font-body text-sm text-foreground/80 leading-snug cursor-pointer">
        Li e aceito a
        <a href="/politica-de-privacidade/" class="font-medium text-primary underline underline-offset-2 hover:text-primary/80" target="_blank" rel="noopener noreferrer">
          Política de Privacidade
        </a>
        <span class="text-destructive" aria-hidden="true"> *</span>
      </label>
    </div>
    <span class="hidden text-xs text-destructive mt-1" id="catalog-gdpr-error" role="alert">É necessário aceitar a Política de Privacidade.</span>

    <!-- Submit -->
    <div class="mt-6">
      <button
        type="submit"
        id="catalog-submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[hsl(16_76%_60%)] px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[hsl(16_76%_54%)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(16_76%_60%)] focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="catalog-submit-text">Receber Catálogo Gratuito</span>
        <svg id="catalog-spinner" class="hidden h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById('catalog-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('catalog-submit') as HTMLButtonElement | null;
  const submitText = document.getElementById('catalog-submit-text');
  const spinner = document.getElementById('catalog-spinner');
  const successEl = document.getElementById('catalog-success');
  const errorEl = document.getElementById('catalog-error');

  function showFieldError(id: string, show: boolean) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('hidden', !show);
  }

  function validateForm(data: FormData): boolean {
    let valid = true;

    const nome = (data.get('nome') as string)?.trim();
    showFieldError('catalog-nome-error', !nome);
    if (!nome) valid = false;

    const email = (data.get('email') as string)?.trim();
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email ?? '');
    showFieldError('catalog-email-error', !emailOk);
    if (!emailOk) valid = false;

    const gdpr = data.get('gdpr');
    showFieldError('catalog-gdpr-error', !gdpr);
    if (!gdpr) valid = false;

    return valid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = new FormData(form);
    if (!validateForm(data)) return;

    // Set loading state
    if (submitBtn) submitBtn.disabled = true;
    submitText?.classList.add('hidden');
    spinner?.classList.remove('hidden');
    errorEl?.classList.add('hidden');

    try {
      const response = await fetch('/api/catalogo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(data)),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      // Show success
      form.classList.add('hidden');
      successEl?.classList.remove('hidden');
    } catch {
      errorEl?.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = false;
      submitText?.classList.remove('hidden');
      spinner?.classList.add('hidden');
    }
  });
</script>
