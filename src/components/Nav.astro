---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const currentPath = Astro.url.pathname;

const equipamentosLinks = [
  { label: 'Elevadores de Escadas', href: '/equipamentos/elevadores-de-escadas/' },
  { label: 'Elevadores Residenciais', href: '/equipamentos/elevadores/' },
  { label: 'Plataformas Elevatórias', href: '/equipamentos/plataformas-elevatorias/' },
];

const solucoesLinks = [
  { label: 'Soluções para Subir Escadas', href: '/solucoes-para-subir-escadas/' },
  { label: 'Cadeiras Elevatórias para Idosos', href: '/cadeiras-elevatorias-para-idosos/' },
  { label: 'Soluções para Cadeiras de Rodas', href: '/solucoes-para-cadeiras-de-rodas/' },
  { label: 'Adaptar Casa: Mobilidade Reduzida', href: '/adaptar-casa-mobilidade-reduzida/' },
  { label: 'Acessibilidade em Condomínios', href: '/acessibilidade-condominios/' },
];

const precosLinks = [
  { label: 'Preços: Elevadores de Escadas', href: '/equipamentos/elevadores-de-escadas/preco/' },
  { label: 'Preços: Elevadores Residenciais', href: '/equipamentos/elevadores/preco/' },
  { label: 'Preços: Plataformas Elevatórias', href: '/equipamentos/plataformas-elevatorias/preco/' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-8">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0 flex items-center gap-2" aria-label="Vida Acessível - Página inicial">
      <Image src={logo} alt="Vida Acessível" class="h-9 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegação principal">

      <!-- Equipamentos dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Equipamentos
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div class="absolute left-0 top-full z-20 mt-1 hidden min-w-[220px] rounded-xl border border-border bg-background shadow-lg group-hover:block">
          <ul class="py-1" role="menu">
            {equipamentosLinks.map(link => (
              <li role="none">
                <a
                  href={link.href}
                  class:list={[
                    'block px-4 py-2.5 text-sm font-medium transition-colors hover:bg-accent hover:text-foreground',
                    currentPath === link.href ? 'text-primary' : 'text-foreground/80'
                  ]}
                  role="menuitem"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Soluções dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Soluções
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div class="absolute left-0 top-full z-20 mt-1 hidden min-w-[260px] rounded-xl border border-border bg-background shadow-lg group-hover:block">
          <ul class="py-1" role="menu">
            {solucoesLinks.map(link => (
              <li role="none">
                <a
                  href={link.href}
                  class:list={[
                    'block px-4 py-2.5 text-sm font-medium transition-colors hover:bg-accent hover:text-foreground',
                    currentPath === link.href ? 'text-primary' : 'text-foreground/80'
                  ]}
                  role="menuitem"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Preços dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Preços
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div class="absolute left-0 top-full z-20 mt-1 hidden min-w-[260px] rounded-xl border border-border bg-background shadow-lg group-hover:block">
          <ul class="py-1" role="menu">
            {precosLinks.map(link => (
              <li role="none">
                <a
                  href={link.href}
                  class:list={[
                    'block px-4 py-2.5 text-sm font-medium transition-colors hover:bg-accent hover:text-foreground',
                    currentPath === link.href ? 'text-primary' : 'text-foreground/80'
                  ]}
                  role="menuitem"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Simple links -->
      <a
        href="/recursos/"
        class:list={[
          'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-foreground',
          currentPath.startsWith('/recursos') ? 'text-primary' : 'text-foreground/80'
        ]}
      >
        Recursos
      </a>
      <a
        href="/sobre/"
        class:list={[
          'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-foreground',
          currentPath === '/sobre/' ? 'text-primary' : 'text-foreground/80'
        ]}
      >
        Sobre nós
      </a>
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:block">
      <a
        href="/pedir-orcamento/"
        class="inline-flex items-center justify-center rounded-xl bg-[hsl(16_76%_60%)] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[hsl(16_76%_54%)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(16_76%_60%)] focus-visible:ring-offset-2"
      >
        Pedir Orçamento
      </a>
    </div>

    <!-- Mobile menu toggle -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-foreground/80 hover:bg-accent md:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Hamburger icon -->
      <svg id="icon-menu" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <!-- Close icon -->
      <svg id="icon-close" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-4 pt-2 md:hidden"
    role="navigation"
    aria-label="Navegação móvel"
  >
    <nav class="flex flex-col gap-1">

      <!-- Equipamentos mobile dropdown -->
      <div>
        <button
          type="button"
          data-dropdown-toggle="mobile-equipamentos"
          class="flex w-full items-center justify-between rounded-md px-3 py-2.5 text-base font-medium text-foreground/80 hover:bg-accent hover:text-foreground focus:outline-none"
          aria-expanded="false"
        >
          Equipamentos
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <ul id="mobile-equipamentos" class="hidden ml-4 mt-1 flex-col gap-1">
          {equipamentosLinks.map(link => (
            <li>
              <a href={link.href} class="block rounded-md px-3 py-2 text-sm font-medium text-foreground/70 hover:bg-accent hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Soluções mobile dropdown -->
      <div>
        <button
          type="button"
          data-dropdown-toggle="mobile-solucoes"
          class="flex w-full items-center justify-between rounded-md px-3 py-2.5 text-base font-medium text-foreground/80 hover:bg-accent hover:text-foreground focus:outline-none"
          aria-expanded="false"
        >
          Soluções
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <ul id="mobile-solucoes" class="hidden ml-4 mt-1 flex-col gap-1">
          {solucoesLinks.map(link => (
            <li>
              <a href={link.href} class="block rounded-md px-3 py-2 text-sm font-medium text-foreground/70 hover:bg-accent hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Preços mobile dropdown -->
      <div>
        <button
          type="button"
          data-dropdown-toggle="mobile-precos"
          class="flex w-full items-center justify-between rounded-md px-3 py-2.5 text-base font-medium text-foreground/80 hover:bg-accent hover:text-foreground focus:outline-none"
          aria-expanded="false"
        >
          Preços
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <ul id="mobile-precos" class="hidden ml-4 mt-1 flex-col gap-1">
          {precosLinks.map(link => (
            <li>
              <a href={link.href} class="block rounded-md px-3 py-2 text-sm font-medium text-foreground/70 hover:bg-accent hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Simple mobile links -->
      <a href="/recursos/" class="rounded-md px-3 py-2.5 text-base font-medium text-foreground/80 hover:bg-accent hover:text-foreground">
        Recursos
      </a>
      <a href="/sobre/" class="rounded-md px-3 py-2.5 text-base font-medium text-foreground/80 hover:bg-accent hover:text-foreground">
        Sobre nós
      </a>

      <!-- Mobile CTA -->
      <div class="mt-3 pt-3 border-t border-border">
        <a
          href="/pedir-orcamento/"
          class="flex w-full items-center justify-center rounded-xl bg-[hsl(16_76%_60%)] px-5 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[hsl(16_76%_54%)]"
        >
          Pedir Orçamento
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  menuToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Abrir menu' : 'Fechar menu');
  });

  // Dropdown toggles for mobile
  document.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.dropdownToggle;
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;
      const isExpanded = !target.classList.contains('hidden');
      target.classList.toggle('hidden');
      // Toggle flex display for the list
      if (!target.classList.contains('hidden')) {
        target.classList.add('flex');
      } else {
        target.classList.remove('flex');
      }
      btn.setAttribute('aria-expanded', String(!isExpanded));
    });
  });
</script>
