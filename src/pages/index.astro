---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Vida Acessível",
  "url": "https://www.vidaacessivel.pt",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.vidaacessivel.pt/recursos/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const articles = [
  {
    slug: "guia-de-compra-elevadores-de-escadas",
    category: "Guias de Compra",
    title: "Guia de Compra de Elevadores de Escadas: Tudo o Que Precisa de Saber",
    imageDesc: "Close-up of a person's hands holding a printed guide booklet about stairlifts, sitting at a warm wooden kitchen table in a Portuguese home. Soft natural light. Sony A7R IV, 35mm f/2.0. WebP format.",
    imageCaption: "Guia impresso sobre elevadores de escadas em casa portuguesa",
  },
  {
    slug: "apoios-aquisicao-equipamentos-mobilidade",
    category: "Apoios e Legislação",
    title: "Apoios para a Aquisição de Equipamentos de Mobilidade em Portugal",
    imageDesc: "An older Portuguese couple reviewing paperwork at a kitchen table, looking relieved and hopeful. Warm natural light, ceramic tiles on the wall. Sony A7R IV, 35mm f/2.0. WebP format.",
    imageCaption: "Casal a analisar apoios financeiros para equipamentos de mobilidade",
  },
  {
    slug: "como-funciona-elevador-de-escadas",
    category: "Elevadores de Escadas",
    title: "Como Funciona um Elevador de Escadas?",
    imageDesc: "Detail shot of a stairlift rail mechanism on a wooden staircase in a traditional Portuguese home. Warm interior lighting, terracotta accents, natural wood grain. Sony A7R IV, 35mm f/2.0. WebP format.",
    imageCaption: "Detalhe do mecanismo de calha de um elevador de escadas",
  },
];
---

<Layout
  title="Vida Acessível | Elevadores de Escadas e Soluções de Acessibilidade em Portugal"
  description="Compare elevadores de escadas, elevadores residenciais e plataformas elevatórias. Receba até 3 orçamentos gratuitos de instaladores certificados em Portugal."
  schema={websiteSchema}
>
  <SiteHeader client:load />

  <main>

    <!-- =========================================================
         1. HERO
    ========================================================= -->
    <section class="bg-[#fdfcf8] py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">

          <!-- Text -->
          <div class="order-2 md:order-1">
            <p class="mb-5 inline-block rounded-full bg-[#1D6954]/10 px-3 py-1 text-sm font-medium text-[#1D6954]">
              Uma casa sem obstáculos
            </p>
            <h1 class="font-heading text-4xl font-bold text-foreground md:text-5xl lg:text-[3.25rem]" style="line-height:1.18;">
              Soluções para viver em casa com liberdade e independência
            </h1>
            <p class="mt-6 text-lg text-foreground/65 leading-relaxed max-w-lg">
              Ajudamos a encontrar o equipamento certo para a sua casa — e ligamos-o a instaladores certificados, de forma gratuita e sem pressão.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="/pedir-orcamento/"
                class="inline-flex items-center rounded-full bg-cta px-7 py-3.5 text-base font-semibold text-white transition-opacity hover:opacity-90"
              >
                Pedir orçamento gratuito
              </a>
              <a
                href="/equipamentos/elevadores-de-escadas/preco/"
                class="inline-flex items-center rounded-full border border-foreground/25 px-7 py-3.5 text-base font-medium text-foreground/70 transition-colors hover:border-foreground/50 hover:text-foreground"
              >
                Ver preços →
              </a>
            </div>
            <!-- Trust line -->
            <p class="mt-6 text-sm text-foreground/40">
              Sem compromisso · Grátis · Instaladores verificados
            </p>
          </div>

          <!-- Hero image -->
          <div class="order-1 md:order-2">
            <div
              class="img-placeholder"
              style="background:#ede9e0; display:flex; align-items:center; justify-content:center; position:relative; width:100%; aspect-ratio:3/2; border-radius:16px;"
              data-image-description="Elderly Portuguese woman, late 60s, sitting comfortably on a stairlift in a traditional Portuguese home with stone walls and warm interior light. She looks relaxed and independent. An adult family member is visible in the background, smiling warmly. The staircase has wooden banisters and ceramic tile flooring. Sony A7R IV, 35mm f/2.0, natural light, warm tones. WebP format."
            >
              <span style="position:absolute; top:8px; left:8px; font-size:11px; color:#bbb;">📷 Imagem</span>
              <span style="font-size:13px; color:#bbb; text-align:center; padding:1rem;">
                Mulher idosa a usar cadeira elevatória em casa portuguesa tradicional
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         2. COMO FUNCIONA — 3 steps
    ========================================================= -->
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center mb-14">
          <h2 class="font-heading text-3xl font-bold text-foreground md:text-4xl">Como funciona</h2>
          <p class="mt-4 text-base text-foreground/55 max-w-md mx-auto leading-relaxed">
            Três passos simples. Sem compromisso, sem custo, sem pressão.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
          <!-- Step 1 -->
          <div class="flex flex-col items-start md:items-center md:text-center">
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-cta/10">
              <span class="font-heading text-xl font-bold text-cta">1</span>
            </div>
            <h3 class="font-heading text-lg font-semibold text-foreground mb-3">Diz-nos o que procura</h3>
            <p class="text-base text-foreground/55 leading-relaxed">
              Preenche um formulário rápido — o tipo de equipamento, a escada, a urgência. Leva 2 minutos.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="flex flex-col items-start md:items-center md:text-center">
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-cta/10">
              <span class="font-heading text-xl font-bold text-cta">2</span>
            </div>
            <h3 class="font-heading text-lg font-semibold text-foreground mb-3">Recebe propostas gratuitas</h3>
            <p class="text-base text-foreground/55 leading-relaxed">
              Até 3 instaladores certificados analisam o seu caso e enviam uma proposta personalizada.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="flex flex-col items-start md:items-center md:text-center">
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-cta/10">
              <span class="font-heading text-xl font-bold text-cta">3</span>
            </div>
            <h3 class="font-heading text-lg font-semibold text-foreground mb-3">Compara e decide com calma</h3>
            <p class="text-base text-foreground/55 leading-relaxed">
              Vê as propostas lado a lado. Sem pressão. Escolhe quando — e se — estiver pronto.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         3. SOLUÇÕES — 3 product cards
    ========================================================= -->
    <section class="bg-[#fdfcf8] py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center mb-12">
          <h2 class="font-heading text-3xl font-bold text-foreground md:text-4xl">Soluções adaptadas à sua casa e à sua vida</h2>
          <p class="mt-4 text-base text-foreground/55 max-w-xl mx-auto leading-relaxed">
            Cada situação é diferente. Explore as opções disponíveis, perceba as diferenças e encontre o equipamento certo para si ou para quem precisa de apoio.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Card 1: Elevadores de Escadas -->
          <a href="/equipamentos/elevadores-de-escadas/" class="group block rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div
              class="img-placeholder"
              style="background:#ede9e0; display:flex; align-items:center; justify-content:center; position:relative; width:100%; aspect-ratio:4/3;"
              data-image-description="A compact stairlift chair on a straight wooden staircase inside a traditional Portuguese home. The chair is folded neatly against the wall. Warm cream-coloured walls, ceramic tile floor visible at the base. Natural light from a window. Sony A7R IV, 35mm f/2.0. WebP format."
            >
              <span style="position:absolute; top:8px; left:8px; font-size:11px; color:#bbb;">📷 Imagem</span>
              <span style="font-size:13px; color:#bbb; text-align:center; padding:1rem;">
                Elevador de escadas em casa portuguesa
              </span>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#1D6954] mb-1">Para todos os tipos de escadas</p>
              <h3 class="font-heading text-xl font-bold text-foreground mb-2 group-hover:text-[#1D6954] transition-colors">Elevadores de Escadas</h3>
              <p class="text-sm text-foreground/55 leading-relaxed mb-4">
                Suba e desça com segurança e conforto, sem obras nem complicações.
              </p>
              <span class="text-sm font-semibold text-cta group-hover:underline">Saber mais →</span>
            </div>
          </a>

          <!-- Card 2: Elevadores Residenciais -->
          <a href="/equipamentos/elevadores/" class="group block rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div
              class="img-placeholder"
              style="background:#ede9e0; display:flex; align-items:center; justify-content:center; position:relative; width:100%; aspect-ratio:4/3;"
              data-image-description="A small modern home lift (homelift) inside a contemporary Portuguese villa. Glass panels, warm interior lighting, visible through an open doorway. The lift connects two floors. An older couple stands nearby, looking pleased. Sony A7R IV, 35mm f/2.0, natural interior light. WebP format."
            >
              <span style="position:absolute; top:8px; left:8px; font-size:11px; color:#bbb;">📷 Imagem</span>
              <span style="font-size:13px; color:#bbb; text-align:center; padding:1rem;">
                Elevador residencial compacto em moradia portuguesa
              </span>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#1D6954] mb-1">Para ligar pisos com elegância</p>
              <h3 class="font-heading text-xl font-bold text-foreground mb-2 group-hover:text-[#1D6954] transition-colors">Elevadores Residenciais</h3>
              <p class="text-sm text-foreground/55 leading-relaxed mb-4">
                Uma solução discreta e adaptada ao espaço da sua casa.
              </p>
              <span class="text-sm font-semibold text-cta group-hover:underline">Saber mais →</span>
            </div>
          </a>

          <!-- Card 3: Plataformas Elevatórias -->
          <a href="/equipamentos/plataformas-elevatorias/" class="group block rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div
              class="img-placeholder"
              style="background:#ede9e0; display:flex; align-items:center; justify-content:center; position:relative; width:100%; aspect-ratio:4/3;"
              data-image-description="A wheelchair platform lift on a straight staircase inside a Portuguese apartment building common area. The platform is at the bottom of the stairs, slightly raised. Tiled floors and light walls. An older man in a wheelchair is about to use the platform. Sony A7R IV, 35mm f/2.0, natural light. WebP format."
            >
              <span style="position:absolute; top:8px; left:8px; font-size:11px; color:#bbb;">📷 Imagem</span>
              <span style="font-size:13px; color:#bbb; text-align:center; padding:1rem;">
                Plataforma elevatória para cadeira de rodas em edifício português
              </span>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#1D6954] mb-1">Para cadeira de rodas e mobilidade reduzida</p>
              <h3 class="font-heading text-xl font-bold text-foreground mb-2 group-hover:text-[#1D6954] transition-colors">Plataformas Elevatórias</h3>
              <p class="text-sm text-foreground/55 leading-relaxed mb-4">
                Ultrapasse desníveis e escadas com total segurança e independência.
              </p>
              <span class="text-sm font-semibold text-cta group-hover:underline">Saber mais →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================================
         4. PORQUÊ VIDA ACESSÍVEL — 4 USPs
    ========================================================= -->
    <section class="bg-[#f5f1eb] py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center mb-12">
          <h2 class="font-heading text-3xl font-bold text-foreground md:text-4xl">O que fazemos por si</h2>
          <p class="mt-4 text-base text-foreground/55 max-w-xl mx-auto leading-relaxed">
            Encontrar a solução certa para casa não devia ser complicado. Por isso reunimos tudo num só sítio: informação clara, opções comparadas e pedidos de orçamento sem complicações.<br class="hidden md:block" /><br class="hidden md:block" />Rápido de perceber. Fácil de avançar.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl bg-white px-6 py-7 shadow-sm">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-[#1D6954]/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#1D6954]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12c0 4.4 3.5 8 7.8 8 2 0 3.8-.8 5.2-2"/>
              </svg>
            </div>
            <h3 class="font-heading text-base font-semibold text-foreground mb-2">Até 3 orçamentos gratuitos</h3>
            <p class="text-sm text-foreground/55 leading-relaxed">
              Receba propostas de vários instaladores e compare sem custo nem compromisso.
            </p>
          </div>

          <div class="rounded-2xl bg-white px-6 py-7 shadow-sm">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-[#1D6954]/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#1D6954]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3 class="font-heading text-base font-semibold text-foreground mb-2">Instaladores certificados</h3>
            <p class="text-sm text-foreground/55 leading-relaxed">
              Trabalhamos apenas com empresas verificadas e com experiência comprovada.
            </p>
          </div>

          <div class="rounded-2xl bg-white px-6 py-7 shadow-sm">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-[#1D6954]/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#1D6954]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </div>
            <h3 class="font-heading text-base font-semibold text-foreground mb-2">Processo simples</h3>
            <p class="text-sm text-foreground/55 leading-relaxed">
              Preenche um formulário em 2 minutos. Nós tratamos do resto.
            </p>
          </div>

          <div class="rounded-2xl bg-white px-6 py-7 shadow-sm">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-[#1D6954]/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#1D6954]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <h3 class="font-heading text-base font-semibold text-foreground mb-2">Cobertura nacional</h3>
            <p class="text-sm text-foreground/55 leading-relaxed">
              Parceiros em todo o Portugal continental e ilhas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         5. CIDADES — city chips
    ========================================================= -->
    <section class="bg-white py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center mb-8">
          <h2 class="font-heading text-2xl font-bold text-foreground">Parceiros de confiança em todo o país</h2>
          <p class="mt-3 text-sm text-foreground/55 max-w-lg mx-auto leading-relaxed">
            Trabalhamos com uma rede de instaladores experientes, presentes em todas as regiões de Portugal. Onde quer que esteja, há um profissional qualificado perto de si, pronto para avaliar, aconselhar e instalar.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-2.5">
          {/* TODO: wire city links to local pages when built */}
          {["Lisboa", "Porto", "Braga", "Aveiro", "Coimbra", "Setúbal", "Faro", "Leiria", "Viseu", "Évora", "Guimarães", "Funchal"].map((city) => (
            <a
              href="#"
              class="rounded-full border border-border bg-[#fdfcf8] px-4 py-2 text-sm font-medium text-foreground/60 transition-colors hover:border-cta hover:text-cta"
            >
              {city}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================================================
         6. ARTIGOS RECENTES
    ========================================================= -->
    <section class="bg-[#f5f1eb] py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center mb-12">
          <h2 class="font-heading text-3xl font-bold text-foreground md:text-4xl">Guias e recursos úteis</h2>
          <p class="mt-4 text-base text-foreground/55 max-w-md mx-auto leading-relaxed">
            Informação clara e prática para tomar a melhor decisão, ao seu ritmo.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {articles.map((article) => (
            <article>
              <a href={`/recursos/${article.slug}`} class="group block">
                <!-- Image -->
                <div
                  class="img-placeholder rounded-2xl overflow-hidden mb-4"
                  style="background:#ede9e0; display:flex; align-items:center; justify-content:center; position:relative; width:100%; aspect-ratio:4/3;"
                  data-image-description={article.imageDesc}
                >
                  <span style="position:absolute; top:8px; left:8px; font-size:11px; color:#bbb;">📷 Imagem</span>
                  <span style="font-size:12px; color:#bbb; text-align:center; padding:1rem;">
                    {article.imageCaption}
                  </span>
                </div>
                <!-- Category — bold -->
                <p class="text-sm font-bold text-foreground mb-1">{article.category}</p>
                <!-- Title — normal weight, links -->
                <p class="text-base text-foreground/70 leading-snug group-hover:text-foreground transition-colors">
                  {article.title}
                </p>
              </a>
            </article>
          ))}
        </div>

        <div class="mt-12 text-center">
          <a
            href="/recursos/"
            class="inline-flex items-center rounded-full border border-foreground/25 px-7 py-3 text-sm font-semibold text-foreground/70 transition-colors hover:border-foreground/50 hover:text-foreground"
          >
            Ver todos os artigos →
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================================
         7. PROFISSIONAIS — B2B partnerships section
    ========================================================= -->
    <section class="bg-secondary py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-16 items-start">

          <!-- Left: label + big H2 -->
          <div>
            <span class="inline-block rounded-full border border-foreground/30 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-foreground/60 mb-6">
              Profissionais
            </span>
            <h2 class="font-heading text-4xl font-bold leading-tight text-primary md:text-5xl">
              Tem um produto ou serviço para divulgar no nosso site?
            </h2>
          </div>

          <!-- Right: intro + 2 feature cards + CTAs -->
          <div>
            <p class="text-base text-foreground/65 leading-relaxed mb-10">
              Se tem uma empresa ou presta serviços na área de acessibilidade e mobilidade, pode juntar-se à rede Vida Acessível e apresentar os seus produtos a quem está à procura de soluções como as suas.
            </p>

            <div class="grid grid-cols-2 gap-8 mb-10">
              <div>
                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v3l2 2"/>
                  </svg>
                </div>
                <h3 class="font-heading text-base font-bold text-primary mb-2 leading-snug">
                  Aumente a visibilidade da sua empresa
                </h3>
                <p class="text-sm text-foreground/60 leading-relaxed">
                  Destaque-se num mercado específico e chegue a um público que valoriza qualidade e confiança.
                </p>
              </div>

              <div>
                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <h3 class="font-heading text-base font-bold text-primary mb-2 leading-snug">
                  Divulgue e conecte-se com clientes
                </h3>
                <p class="text-sm text-foreground/60 leading-relaxed">
                  Apresente os seus serviços e estabeleça contacto direto com quem realmente precisa das suas soluções.
                </p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-4">
              <a
                href="/contacto/"
                class="inline-flex items-center rounded-full bg-cta px-7 py-3 text-base font-semibold text-white transition-opacity hover:opacity-90"
              >
                Contactar
              </a>
              <a
                href="/sobre/"
                class="inline-flex items-center gap-1 text-base font-semibold text-foreground/65 hover:text-foreground transition-colors"
              >
                Saber mais →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter client:load />
</Layout>
