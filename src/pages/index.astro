---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

let recentPosts: any[] = [];
try {
  const posts = await getCollection('recursos');
  recentPosts = posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
} catch (e) {
  // Content collection may not yet be populated
}

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Vida Acessível",
  "url": "https://vidaacessivel.pt",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://vidaacessivel.pt/recursos/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Vida Acessível — Elevadores de Escadas e Plataformas Elevatórias em Portugal"
  description="Compare orçamentos gratuitos de elevadores de escadas, elevadores residenciais e plataformas elevatórias em Portugal. Até 3 propostas de instaladores certificados."
  canonical="https://vidaacessivel.pt/"
  schema={websiteSchema}
>

  <!-- Hero -->
  <section class="bg-secondary py-20 md:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-6">
            Soluções de Mobilidade em Portugal
          </span>
          <h1 class="font-heading font-extrabold text-4xl md:text-5xl lg:text-6xl text-foreground leading-tight mb-6">
            Soluções de Acessibilidade para a Sua Casa
          </h1>
          <p class="font-body text-lg md:text-xl text-muted-foreground leading-relaxed mb-8 max-w-lg">
            Ajudamos a encontrar o equipamento certo e instaladores de confiança. Receba até 3 orçamentos gratuitos de instaladores certificados, sem compromisso.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/pedir-orcamento/" class="inline-flex items-center justify-center px-8 py-3.5 bg-cta text-white font-heading font-bold rounded-full shadow-lg shadow-cta/25 hover:shadow-xl transition-all">
              Pedir Orçamento Gratuito
            </a>
            <a href="/catalogo-gratis/" class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary hover:text-white transition-all">
              Catálogo Grátis
            </a>
          </div>
          <p class="font-body text-sm text-muted-foreground mt-4">Grátis e sem compromisso — até 3 propostas comparáveis</p>
        </div>
        <div class="relative">
          <div class="img-placeholder bg-primary/10 rounded-2xl w-full h-[420px] flex items-center justify-center shadow-2xl shadow-primary/10"
               data-image-description="Mulher idosa portuguesa, 70 anos, a entrar tranquilamente em casa moderna usando elevador de escadas, família ao fundo a sorrir, luz natural quente, fotografia documental realista, Sony A7R IV, WebP">
            <span class="text-muted-foreground text-sm">Imagem: família com elevador de escadas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Como ajudamos -->
  <section class="py-20 md:py-24 bg-background">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Como ajudamos</h2>
      <p class="font-body text-muted-foreground mb-12 max-w-xl mx-auto">Três passos simples para encontrar a solução certa para a sua casa.</p>
      <div class="grid sm:grid-cols-3 gap-8">
        {[
          { step: "1", title: "Indique o que procura", desc: "Diga-nos o tipo de escada e equipamento que procura. Leva 2 minutos." },
          { step: "2", title: "Receba até 3 propostas", desc: "Instaladores certificados na sua região contactam-no com orçamentos detalhados." },
          { step: "3", title: "Compare e escolha", desc: "Compare preços, prazos e garantias. Só avança quando estiver seguro da escolha." },
        ].map(({ step, title, desc }) => (
          <div>
            <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="font-heading font-extrabold text-2xl text-primary">{step}</span>
            </div>
            <h3 class="font-heading font-bold text-foreground mb-2">{title}</h3>
            <p class="font-body text-sm text-muted-foreground">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Soluções -->
  <section class="py-20 md:py-24 bg-secondary">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center mb-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Equipamentos disponíveis</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Três categorias de solução para diferentes necessidades e tipos de habitação.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/equipamentos/elevadores-de-escadas/" class="bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow group">
          <div class="img-placeholder bg-primary/10 w-full h-[220px] flex items-center justify-center"
               data-image-description="Elevador de escadas moderno e elegante numa casa portuguesa, assento branco, carril metálico, escada de madeira, luz natural quente, WebP">
            <span class="text-muted-foreground text-sm">Imagem: elevador de escadas</span>
          </div>
          <div class="p-6">
            <span class="inline-block bg-primary/10 text-primary font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full mb-3">Mais popular</span>
            <h3 class="font-heading font-bold text-xl text-foreground mb-2 group-hover:text-primary transition-colors">Elevadores de Escadas</h3>
            <p class="font-body text-sm text-muted-foreground mb-4">Para escadas retas, curvas ou exteriores. Instalação em 1 dia, sem obras. A partir de €3.000.</p>
            <span class="text-primary font-body text-sm font-medium">Ver soluções →</span>
          </div>
        </a>
        <a href="/equipamentos/elevadores/" class="bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow group">
          <div class="img-placeholder bg-primary/10 w-full h-[220px] flex items-center justify-center"
               data-image-description="Elevador residencial compacto e moderno numa moradia portuguesa contemporânea, portas de vidro abertas, design elegante, WebP">
            <span class="text-muted-foreground text-sm">Imagem: elevador residencial</span>
          </div>
          <div class="p-6">
            <span class="inline-block bg-secondary text-foreground font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full mb-3">Solução permanente</span>
            <h3 class="font-heading font-bold text-xl text-foreground mb-2 group-hover:text-primary transition-colors">Elevadores Residenciais</h3>
            <p class="font-body text-sm text-muted-foreground mb-4">Para moradias com vários pisos. Discreto, duradouro e valoriza o imóvel. A partir de €8.000.</p>
            <span class="text-primary font-body text-sm font-medium">Ver soluções →</span>
          </div>
        </a>
        <a href="/equipamentos/plataformas-elevatorias/" class="bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow group">
          <div class="img-placeholder bg-primary/10 w-full h-[220px] flex items-center justify-center"
               data-image-description="Plataforma elevatória numa escada de condomínio português, utilizador em cadeira de rodas, plataforma com bordas de segurança erguidas, WebP">
            <span class="text-muted-foreground text-sm">Imagem: plataforma elevatória</span>
          </div>
          <div class="p-6">
            <span class="inline-block bg-secondary text-foreground font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full mb-3">Para cadeira de rodas</span>
            <h3 class="font-heading font-bold text-xl text-foreground mb-2 group-hover:text-primary transition-colors">Plataformas Elevatórias</h3>
            <p class="font-body text-sm text-muted-foreground mb-4">Para cadeira de rodas em casa ou condomínio. Norma EN 81-41. A partir de €5.000.</p>
            <span class="text-primary font-body text-sm font-medium">Ver soluções →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Porquê Vida Acessível -->
  <section class="py-20 md:py-24 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Porquê o Vida Acessível</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Um processo simples, transparente e sem pressão.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {[
          { d: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z", title: "Totalmente gratuito", desc: "O serviço de comparação de orçamentos é 100% gratuito para o utilizador. Sem taxas, sem comissões ocultas." },
          { d: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z", title: "Parceiros certificados", desc: "Verificamos as credenciais de todos os instaladores parceiros." },
          { d: "M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z", title: "Sem compromisso", desc: "Receber orçamentos não cria qualquer obrigação. Decida ao seu ritmo." },
          { d: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6", title: "Cobertura nacional", desc: "Instaladores certificados em todo o Portugal continental e ilhas." },
        ].map(({ d, title, desc }) => (
          <div class="flex gap-4 p-6 bg-card border border-border rounded-2xl">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d} />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-foreground mb-1">{title}</h3>
              <p class="font-body text-sm text-muted-foreground">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage -->
  <section class="py-16 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <h2 class="font-heading font-bold text-2xl text-foreground mb-3">Parceiros em todo o país</h2>
      <p class="font-body text-muted-foreground mb-8">Rede de instaladores certificados em todas as regiões de Portugal.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {["Porto", "Braga", "Viana do Castelo", "Vila Real", "Coimbra", "Viseu", "Aveiro", "Lisboa", "Setúbal", "Évora", "Faro", "Açores", "Madeira"].map(city => (
          <span class="bg-card border border-border rounded-full px-4 py-2 font-body text-sm text-muted-foreground">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Artigos recentes -->
  {recentPosts.length > 0 && (
    <section class="py-20 md:py-24 bg-background">
      <div class="max-w-[880px] mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-heading font-bold text-2xl text-foreground">Artigos recentes</h2>
          <a href="/recursos/" class="text-primary font-body text-sm font-medium hover:underline">Ver todos →</a>
        </div>
        <div class="grid sm:grid-cols-3 gap-6">
          {recentPosts.map(post => (
            <a href={`/recursos/${post.slug}/`} class="bg-card border border-border rounded-2xl p-5 hover:shadow-md transition-shadow group">
              <span class="inline-block bg-primary/10 text-primary font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full mb-3">{post.data.category}</span>
              <h3 class="font-heading font-semibold text-foreground text-sm group-hover:text-primary transition-colors mb-2">{post.data.title}</h3>
              <p class="font-body text-xs text-muted-foreground">{post.data.description.slice(0, 90)}...</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Banner -->
  <section class="py-20 bg-primary text-white">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <h2 class="font-heading font-extrabold text-2xl md:text-3xl mb-3">Receba até 3 orçamentos gratuitos</h2>
      <p class="font-body text-white/80 mb-8 max-w-xl mx-auto">Compare propostas de instaladores certificados na sua região. Sem compromisso, resposta em 48 horas.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pedir-orcamento/" class="inline-flex items-center justify-center px-8 py-3.5 bg-cta text-white font-heading font-bold rounded-full shadow-lg hover:shadow-xl transition-all">
          Pedir Orçamento Gratuito
        </a>
        <a href="/catalogo-gratis/" class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-white text-white font-heading font-bold rounded-full hover:bg-white hover:text-primary transition-all">
          Catálogo Grátis
        </a>
      </div>
    </div>
  </section>

</Layout>
