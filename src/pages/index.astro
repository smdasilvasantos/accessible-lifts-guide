---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://vidaacessivel.pt';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vida Acessível',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/recursos/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const schemas = [websiteSchema];

const recentArticles = [
  {
    slug: 'quanto-custa-elevador-de-escadas',
    title: 'Quanto custa um elevador de escadas em Portugal?',
    excerpt: 'Descubra os preços reais de elevadores de escadas em Portugal, os fatores que influenciam o custo e como obter orçamentos competitivos.',
    category: 'Preços',
    date: '2024-11-15',
  },
  {
    slug: 'cadeira-elevatoria-vs-plataforma',
    title: 'Cadeira elevatória vs plataforma elevatória: qual escolher?',
    excerpt: 'Uma comparação honesta entre os dois tipos de equipamentos: vantagens, desvantagens e qual é o mais adequado para cada situação.',
    category: 'Guias',
    date: '2024-11-20',
  },
  {
    slug: 'apoios-estado-mobilidade',
    title: 'IVA 6%, SAPA e apoios do Estado para mobilidade em casa',
    excerpt: 'Conheça todos os apoios financeiros disponíveis em Portugal para equipamentos de acessibilidade e como candidatar-se.',
    category: 'Apoios',
    date: '2024-12-01',
  },
];
---

<Layout
  title="Vida Acessível — Elevadores de Escadas e Soluções de Acessibilidade em Portugal"
  description="Compare orçamentos gratuitos de elevadores de escadas, elevadores residenciais e plataformas elevatórias. Instaladores certificados em todo Portugal."
  canonical="/"
  schemas={schemas}
>
  <Nav />

  <!-- 1. HERO -->
  <section class="relative bg-secondary overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8 items-center min-h-[600px] py-12">
        <div class="order-2 md:order-1">
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-6">
            Soluções de Acessibilidade em Portugal
          </span>
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl lg:text-5xl text-foreground leading-tight mb-5">
            Soluções para viver em sua casa com{' '}
            <span class="text-primary">liberdade e independência</span>
          </h1>
          <p class="font-body text-lg text-muted-foreground leading-relaxed mb-8 max-w-lg">
            Compare orçamentos gratuitos de elevadores de escadas, elevadores residenciais e plataformas elevatórias. Instaladores certificados em todo Portugal.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-7 py-3 text-base font-heading font-bold shadow-lg shadow-cta/25 hover:bg-cta/90 transition-all">
              Pedir Orçamento Gratuito
            </a>
            <a href="/catalogo-gratis/" class="inline-flex items-center rounded-full border border-border bg-background px-7 py-3 text-base font-heading font-semibold text-foreground hover:bg-accent transition-colors">
              Catálogo Grátis
            </a>
          </div>
        </div>
        <div class="order-1 md:order-2 relative">
          <div
            class="rounded-2xl overflow-hidden shadow-2xl shadow-primary/10 h-[350px] md:h-[450px] bg-primary/10 flex items-center justify-center"
            data-image-description="Elderly Portuguese woman, 70s, seated on modern stairlift on warm wooden residential staircase in Portugal, soft natural light from window, dignified and relaxed expression, Sony A7R IV photography style, warm tones, shallow depth of field, WebP format"
          >
            <div class="text-center p-8">
              <div class="w-16 h-16 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </div>
              <p class="font-heading font-semibold text-primary text-sm">Imagem de produto</p>
              <p class="font-body text-xs text-muted-foreground mt-1">A ser gerada</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. COMO AJUDAMOS (3 steps) -->
  <section class="bg-secondary section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-4">
          Orçamentos
        </span>
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">
          Como funciona?
        </h2>
        <p class="font-body text-base text-muted-foreground max-w-xl mx-auto">
          Encontre de forma rápida e segura soluções de acessibilidade e instaladores certificados em Portugal.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { n: '1', title: 'Indique o que procura', desc: 'Diga-nos que equipamento precisa: elevador de escadas, plataforma ou elevador residencial. Sem compromisso.' },
          { n: '2', title: 'Receba até 3 propostas', desc: 'O seu pedido é enviado a instaladores certificados perto de si. Recebe propostas ajustadas ao seu espaço, gratuitamente.' },
          { n: '3', title: 'Compare e escolha', desc: 'Analise as opções, esclareça dúvidas e escolha a que melhor se adapta às suas necessidades e orçamento.' },
        ].map((step) => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center mx-auto mb-5">
              <span class="font-heading font-extrabold text-xl text-primary-foreground">{step.n}</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-foreground mb-2">{step.title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. SOLUÇÕES (3 product cards) -->
  <section class="section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">
          Soluções de acessibilidade adaptadas a si
        </h2>
        <p class="font-body text-base text-muted-foreground max-w-2xl mx-auto">
          Cada casa é diferente, e cada pessoa também. Descubra as opções disponíveis e encontre a solução ideal.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            href: '/equipamentos/elevadores-de-escadas/',
            tag: 'Para todos os tipos de escadas',
            title: 'Elevadores de Escadas',
            desc: 'Suba e desça com conforto e segurança, sem obras complicadas. Ideal para escadas retas, curvas ou exteriores.',
            imgDesc: 'Modern stairlift on a straight residential staircase in a Portuguese home, warm wood tones, elderly person in background, clean and modern design, WebP',
          },
          {
            href: '/equipamentos/elevadores/',
            tag: 'Mais conforto e independência',
            title: 'Elevadores Residenciais',
            desc: 'Um elevador discreto e adaptado ao seu espaço. Solução definitiva para mobilidade entre pisos.',
            imgDesc: 'Small residential home lift installed in a modern Portuguese apartment, glass cabin, minimalist design, bright interior, WebP',
          },
          {
            href: '/equipamentos/plataformas-elevatorias/',
            tag: 'Para espaços residenciais ou públicos',
            title: 'Plataformas Elevatórias',
            desc: 'A forma mais segura e acessível de superar escadas em cadeira de rodas ou para mobilidade reduzida.',
            imgDesc: 'Wheelchair platform lift on a staircase in a Portuguese condominium building, person in wheelchair, accessible design, WebP',
          },
        ].map((sol) => (
          <a
            href={sol.href}
            class="group bg-card border border-border rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow"
          >
            <div
              class="h-52 bg-secondary flex items-center justify-center"
              data-image-description={sol.imgDesc}
            >
              <div class="text-center p-4">
                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><polyline points="18 15 12 9 6 15"></polyline></svg>
                </div>
                <p class="text-xs text-muted-foreground">Imagem a ser gerada</p>
              </div>
            </div>
            <div class="p-6">
              <span class="font-body text-xs text-primary font-semibold uppercase tracking-wide">{sol.tag}</span>
              <h3 class="font-heading font-bold text-lg text-foreground mt-1 mb-2">{sol.title}</h3>
              <p class="font-body text-sm text-muted-foreground mb-4">{sol.desc}</p>
              <span class="inline-flex items-center gap-1 font-heading font-semibold text-sm text-primary group-hover:gap-2 transition-all">
                Saber mais
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. PORQUÊ O VIDA ACESSÍVEL (4 USPs) -->
  <section class="bg-secondary section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">
          Porquê o Vida Acessível?
        </h2>
        <p class="font-body text-base text-muted-foreground max-w-2xl mx-auto">
          Somos uma plataforma independente que trabalha para si — não para as marcas.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: '🔍', title: 'Comparação independente', desc: 'Não somos vendedores. Ajudamos a comparar opções de forma imparcial e transparente.' },
          { icon: '🏆', title: 'Instaladores certificados', desc: 'Todos os parceiros são verificados, com certificação e experiência comprovada em Portugal.' },
          { icon: '💶', title: 'Orçamentos gratuitos', desc: 'Receba até 3 propostas sem qualquer custo ou compromisso da sua parte.' },
          { icon: '🤝', title: 'Apoio personalizado', desc: 'Orientamos desde a primeira dúvida até à instalação, ao ritmo que precisar.' },
        ].map((usp) => (
          <div class="bg-card rounded-2xl border border-border p-6">
            <div class="text-3xl mb-4">{usp.icon}</div>
            <h3 class="font-heading font-bold text-base text-foreground mb-2">{usp.title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{usp.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. PARCEIROS EM TODO O PAÍS -->
  <section class="section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-4">
            Cobertura nacional
          </span>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-4">
            Parceiros de confiança em todo o país
          </h2>
          <p class="font-body text-base text-muted-foreground leading-relaxed mb-6">
            Trabalhamos com instaladores experientes que realizam instalações em qualquer região de Portugal continental e ilhas. Onde quer que esteja, garantimos profissionais qualificados e de confiança.
          </p>
          <div class="grid grid-cols-2 gap-4 mb-6">
            {['Lisboa e Vale do Tejo', 'Porto e Norte', 'Centro', 'Alentejo e Algarve'].map((region) => (
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-primary flex-shrink-0"></div>
                <span class="font-body text-sm text-foreground">{region}</span>
              </div>
            ))}
          </div>
          <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full border border-primary text-primary px-6 py-2.5 text-sm font-heading font-semibold hover:bg-primary hover:text-primary-foreground transition-colors">
            Encontrar instalador
          </a>
        </div>
        <div class="flex justify-center">
          <div
            class="w-64 md:w-80 h-80 md:h-96 rounded-2xl bg-secondary flex items-center justify-center"
            data-image-description="Illustrated map of Portugal with location pins marking major cities (Lisboa, Porto, Coimbra, Faro, Évora, Braga), clean flat design, primary teal color scheme, WebP format"
          >
            <div class="text-center p-8">
              <div class="text-6xl mb-3">🗺️</div>
              <p class="font-heading font-semibold text-primary text-sm">Mapa de Portugal</p>
              <p class="font-body text-xs text-muted-foreground mt-1">Imagem a ser gerada</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. ARTIGOS RECENTES -->
  <section class="bg-secondary section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-1">Artigos recentes</h2>
          <p class="font-body text-base text-muted-foreground">Informação útil para tomar a melhor decisão.</p>
        </div>
        <a href="/recursos/" class="hidden md:inline-flex items-center gap-1 font-heading font-semibold text-sm text-primary hover:gap-2 transition-all">
          Ver todos
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentArticles.map((article) => (
          <a href={`/recursos/${article.slug}/`} class="group bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-44 bg-primary/5 flex items-center justify-center" data-image-description={`Blog article hero image for: ${article.title}, Portuguese accessibility themed, warm editorial style, WebP`}>
              <div class="text-center p-4">
                <span class="inline-block bg-primary/10 text-primary text-xs font-heading font-semibold px-3 py-1 rounded-full">{article.category}</span>
              </div>
            </div>
            <div class="p-5">
              <span class="inline-block bg-primary/10 text-primary text-xs font-heading font-semibold px-2.5 py-1 rounded-full mb-3">{article.category}</span>
              <h3 class="font-heading font-bold text-base text-foreground mb-2 leading-snug group-hover:text-primary transition-colors">{article.title}</h3>
              <p class="font-body text-sm text-muted-foreground mb-4 line-clamp-2">{article.excerpt}</p>
              <span class="inline-flex items-center gap-1 font-heading font-semibold text-sm text-primary group-hover:gap-2 transition-all">
                Continuar a ler
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center md:hidden">
        <a href="/recursos/" class="inline-flex items-center gap-1 font-heading font-semibold text-sm text-primary">
          Ver todos os artigos
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. CTA BANNER -->
  <section class="section-spacing">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="bg-primary rounded-3xl p-10 md:p-14">
        <span class="inline-block bg-white/10 text-white font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-5">
          100% Gratuito &amp; Sem Compromisso
        </span>
        <h2 class="font-heading font-extrabold text-2xl md:text-3xl lg:text-4xl text-white mb-4 leading-tight">
          Receba até 3 orçamentos gratuitos
        </h2>
        <p class="font-body text-base text-white/80 mb-8 max-w-lg mx-auto">
          Compare propostas de instaladores certificados em Portugal e escolha com confiança.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-8 py-3.5 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">
            Pedir Orçamento Gratuito
          </a>
          <a href="/catalogo-gratis/" class="inline-flex items-center rounded-full bg-white/10 text-white px-8 py-3.5 text-base font-heading font-semibold hover:bg-white/20 transition-all">
            Catálogo Grátis
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .bg-cta { background-color: hsl(16 76% 60%); }
  .text-cta-foreground { color: hsl(0 0% 100%); }
  .shadow-cta\/25 { box-shadow: 0 10px 15px -3px hsl(16 76% 60% / 0.25); }
  .line-clamp-2 { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
</style>
