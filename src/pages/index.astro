---
import Layout from '../layouts/Layout.astro';
import AnimatedIcon from '../components/icons/AnimatedIcon.astro';
import { getCollection } from 'astro:content';

let recentPosts: any[] = [];
try {
  const posts = await getCollection('recursos');
  recentPosts = posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
} catch (e) {}

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Vida Acessível",
  "url": "https://vidaacessivel.pt",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://vidaacessivel.pt/recursos/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const cities = [
  "Lisboa", "Porto", "Braga", "Aveiro", "Coimbra",
  "Setúbal", "Faro", "Leiria", "Viseu", "Évora",
  "Guimarães", "Funchal"
];

const categoryColors: Record<string, string> = {
  'Guias': 'bg-blue-100 text-blue-800',
  'Preços': 'bg-green-100 text-green-800',
  'Legislação': 'bg-purple-100 text-purple-800',
  'Instalação': 'bg-orange-100 text-orange-800',
  'Comparações': 'bg-rose-100 text-rose-800',
};
---

<Layout
  title="Vida Acessível — Elevadores de Escadas e Plataformas Elevatórias em Portugal"
  description="Compare orçamentos gratuitos de elevadores de escadas, elevadores residenciais e plataformas elevatórias em Portugal. Até 3 propostas de instaladores certificados."
  canonical="https://vidaacessivel.pt/"
  schema={websiteSchema}
>

  <!-- 1. HERO — problem-first, no form -->
  <section class="bg-secondary py-20 md:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="font-heading font-extrabold text-4xl md:text-5xl lg:text-6xl text-foreground leading-tight mb-4">
            Uma casa sem obstáculos
          </h1>
          <p class="font-body text-lg md:text-xl text-muted-foreground leading-relaxed mb-8 max-w-lg">
            Soluções para viver em casa com liberdade e independência. Comparamos equipamentos e ligamos-o a instaladores certificados — de forma simples, gratuita e sem compromisso.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/equipamentos/elevadores-de-escadas/preco/" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-cta text-white font-heading font-bold rounded-full shadow-lg shadow-cta/25 hover:shadow-xl transition-all group">
              Ver preços
              <AnimatedIcon name="arrow-right" class="w-4 h-4" color="white" />
            </a>
            <a href="/pedir-orcamento/" class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary hover:text-white transition-all">
              Pedir orçamento gratuito
            </a>
          </div>
          <p class="font-body text-sm text-muted-foreground mt-4">Grátis e sem compromisso — até 3 propostas comparáveis</p>
        </div>
        <div class="relative">
          <div class="img-placeholder bg-primary/10 rounded-2xl w-full h-[420px] flex items-center justify-center shadow-2xl shadow-primary/10"
               data-image-description="Mulher idosa portuguesa, 70 anos, a entrar tranquilamente em casa moderna usando elevador de escadas, família ao fundo a sorrir, luz natural quente, fotografia documental realista, WebP">
            <span class="text-muted-foreground text-sm">Imagem: família com elevador de escadas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. COMO FUNCIONA — 3 steps with icons -->
  <section class="py-20 md:py-24 bg-background">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Como funciona</h2>
      <p class="font-body text-muted-foreground mb-14 max-w-xl mx-auto">Três passos simples para encontrar a solução certa para a sua casa.</p>
      <div class="grid sm:grid-cols-3 gap-10">
        {[
          {
            icon: 'file-text' as const,
            step: "1",
            title: "Indique o que procura",
            desc: "Diga-nos o tipo de escada e equipamento que precisa. Leva menos de 2 minutos."
          },
          {
            icon: 'users' as const,
            step: "2",
            title: "Receba até 3 propostas",
            desc: "Instaladores certificados na sua região enviam orçamentos detalhados sem pressão."
          },
          {
            icon: 'check-circle' as const,
            step: "3",
            title: "Compare e escolha",
            desc: "Compare preços, prazos e garantias. Só avança quando estiver seguro."
          },
        ].map(({ icon, step, title, desc }) => (
          <div class="group flex flex-col items-center">
            <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mx-auto mb-5 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-7 h-7" color="hsl(var(--primary))" />
            </div>
            <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center mx-auto mb-3">
              <span class="font-heading font-extrabold text-xs text-white">{step}</span>
            </div>
            <h3 class="font-heading font-bold text-foreground mb-2">{title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. SOLUÇÕES — 3 product cards -->
  <section class="py-20 md:py-24 bg-secondary">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center mb-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Soluções para cada situação</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Três categorias de solução — cada uma adaptada a uma necessidade diferente.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/equipamentos/elevadores-de-escadas/" class="bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow group">
          <div class="p-8 pb-4 flex justify-between items-start">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
              <AnimatedIcon name="stairs" class="w-7 h-7" color="hsl(var(--primary))" />
            </div>
            <span class="inline-block bg-primary/10 text-primary font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full">Mais popular</span>
          </div>
          <div class="p-6 pt-2">
            <h3 class="font-heading font-bold text-xl text-foreground mb-2 group-hover:text-primary transition-colors">Elevadores de Escadas</h3>
            <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Para escadas retas, curvas ou exteriores. Instalação em 1 dia, sem obras. A sua escada fica tal como está.</p>
            <p class="font-heading font-semibold text-primary text-sm mb-4">A partir de 2.500€</p>
            <span class="inline-flex items-center gap-1 text-primary font-body text-sm font-medium group-hover:gap-2 transition-all">
              Ver soluções
              <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
            </span>
          </div>
        </a>

        <a href="/equipamentos/elevadores/" class="bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow group">
          <div class="p-8 pb-4 flex justify-between items-start">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
              <AnimatedIcon name="home" class="w-7 h-7" color="hsl(var(--primary))" />
            </div>
            <span class="inline-block bg-secondary text-foreground font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full border border-border">Solução permanente</span>
          </div>
          <div class="p-6 pt-2">
            <h3 class="font-heading font-bold text-xl text-foreground mb-2 group-hover:text-primary transition-colors">Elevadores Residenciais</h3>
            <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Para moradias com vários pisos. Discreto, duradouro e valoriza o imóvel. Hidráulico, elétrico ou pneumático.</p>
            <p class="font-heading font-semibold text-primary text-sm mb-4">A partir de 8.000€</p>
            <span class="inline-flex items-center gap-1 text-primary font-body text-sm font-medium group-hover:gap-2 transition-all">
              Ver soluções
              <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
            </span>
          </div>
        </a>

        <a href="/equipamentos/plataformas-elevatorias/" class="bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow group">
          <div class="p-8 pb-4 flex justify-between items-start">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
              <AnimatedIcon name="wheelchair" class="w-7 h-7" color="hsl(var(--primary))" />
            </div>
            <span class="inline-block bg-secondary text-foreground font-heading text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full border border-border">Para cadeira de rodas</span>
          </div>
          <div class="p-6 pt-2">
            <h3 class="font-heading font-bold text-xl text-foreground mb-2 group-hover:text-primary transition-colors">Plataformas Elevatórias</h3>
            <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Para quem usa cadeira de rodas. A plataforma sobe com o utilizador — sem sair da cadeira. Em casa ou condomínio.</p>
            <p class="font-heading font-semibold text-primary text-sm mb-4">A partir de 4.000€</p>
            <span class="inline-flex items-center gap-1 text-primary font-body text-sm font-medium group-hover:gap-2 transition-all">
              Ver soluções
              <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. PORQUÊ VIDA ACESSÍVEL — 4 USPs -->
  <section class="py-20 md:py-24 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Porquê o Vida Acessível</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Um processo simples, transparente e sem pressão de qualquer tipo.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {[
          { icon: 'euro' as const, title: "Totalmente gratuito", desc: "O serviço de comparação de orçamentos é 100% gratuito. Sem taxas, sem comissões ocultas, sem letra pequena." },
          { icon: 'shield' as const, title: "Instaladores certificados", desc: "Verificamos as credenciais de todos os parceiros. Só trabalha com técnicos com experiência comprovada." },
          { icon: 'check-circle' as const, title: "Sem compromisso", desc: "Receber orçamentos não cria qualquer obrigação. Decida ao seu próprio ritmo, sem pressão de ninguém." },
          { icon: 'map-pin' as const, title: "Cobertura nacional", desc: "Instaladores certificados em todo o Portugal continental, Açores e Madeira." },
        ].map(({ icon, title, desc }) => (
          <div class="flex gap-4 p-6 bg-card border border-border rounded-2xl group hover:border-primary/30 transition-colors">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <div>
              <h3 class="font-heading font-semibold text-foreground mb-1">{title}</h3>
              <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. CIDADES — instaladores em todo Portugal -->
  <section class="py-16 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
        <AnimatedIcon name="map-pin" class="w-6 h-6" color="hsl(var(--primary))" />
      </div>
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Instaladores certificados em todo o Portugal</h2>
      <p class="font-body text-muted-foreground mb-8 max-w-lg mx-auto">A nossa rede cobre todo o país. Encontre o instalador certo para a sua zona.</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {cities.map(city => (
          <a
            href="#"
            class="group bg-card border border-border rounded-full px-4 py-2 font-body text-sm text-foreground hover:border-primary hover:text-primary hover:bg-primary/5 transition-all inline-flex items-center gap-1.5"
          >
            <AnimatedIcon name="map-pin" class="w-3 h-3" color="hsl(var(--primary))" />
            {city}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. ARTIGOS RECENTES -->
  {recentPosts.length > 0 && (
    <section class="py-20 md:py-24 bg-background">
      <div class="max-w-[880px] mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-heading font-bold text-2xl text-foreground">Artigos recentes</h2>
          <a href="/recursos/" class="inline-flex items-center gap-1 text-primary font-body text-sm font-medium hover:underline group">
            Ver todos
            <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
          </a>
        </div>
        <div class="grid sm:grid-cols-3 gap-6">
          {recentPosts.map(post => (
            <a href={`/recursos/${post.slug}/`} class="bg-card border border-border rounded-2xl p-5 hover:shadow-md transition-shadow group">
              <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold mb-3 ${categoryColors[post.data.category] ?? 'bg-secondary text-foreground'}`}>
                {post.data.category}
              </span>
              <h3 class="font-heading font-semibold text-foreground text-sm group-hover:text-primary transition-colors mb-2 leading-snug">{post.data.title}</h3>
              <p class="font-body text-xs text-muted-foreground leading-relaxed">{post.data.description.slice(0, 90)}...</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. PROFISSIONAIS -->
  <section class="py-20 md:py-24 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="rounded-2xl border border-border bg-card overflow-hidden">
        <div class="bg-primary/5 border-b border-border px-8 py-6">
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-4">Profissionais</span>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Tem um produto ou serviço para divulgar no nosso site?</h2>
          <p class="font-body text-muted-foreground max-w-xl">Se tem uma empresa ou presta serviços na área de acessibilidade e mobilidade, pode juntar-se à rede Vida Acessível e apresentar os seus produtos a quem está à procura de soluções como as suas.</p>
        </div>
        <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border">
          <div class="p-8 group">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name="star" class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-2">Aumente a visibilidade da sua empresa</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">Destaque-se num mercado específico e chegue a um público que valoriza qualidade e confiança.</p>
          </div>
          <div class="p-8 group">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name="users" class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-2">Divulgue e conecte-se com clientes</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">Apresente os seus serviços e estabeleça contacto direto com quem realmente precisa das suas soluções.</p>
          </div>
        </div>
        <div class="px-8 py-5 border-t border-border bg-secondary/50 flex flex-col sm:flex-row sm:items-center gap-4">
          <p class="font-body text-sm text-muted-foreground flex-1">Junte-se à rede Vida Acessível e faça crescer o seu negócio.</p>
          <a href="/pedir-orcamento/" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary text-white font-heading font-semibold rounded-full hover:bg-primary/90 transition-colors shrink-0 group">
            Saber mais
            <AnimatedIcon name="arrow-right" class="w-4 h-4" color="white" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. CTA BANNER — form CTA lives here -->
  <section class="py-20 bg-primary text-white">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center mx-auto mb-6">
        <AnimatedIcon name="check-circle" class="w-6 h-6" color="white" />
      </div>
      <h2 class="font-heading font-extrabold text-2xl md:text-3xl mb-3">Receba até 3 orçamentos gratuitos</h2>
      <p class="font-body text-white/80 mb-8 max-w-xl mx-auto">Compare propostas de instaladores certificados na sua região. Sem compromisso, resposta em 48 horas.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pedir-orcamento/" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-cta text-white font-heading font-bold rounded-full shadow-lg hover:shadow-xl transition-all group">
          Pedir Orçamento Gratuito
          <AnimatedIcon name="send" class="w-4 h-4" color="white" />
        </a>
        <a href="/catalogo-gratis/" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border-2 border-white text-white font-heading font-bold rounded-full hover:bg-white hover:text-primary transition-all group">
          <AnimatedIcon name="file-text" class="w-4 h-4" color="currentColor" />
          Catálogo Grátis
        </a>
      </div>
    </div>
  </section>

</Layout>
