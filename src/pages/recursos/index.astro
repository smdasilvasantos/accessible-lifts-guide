---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('recursos');
const articles = allArticles.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categories = ['Todos', 'Preços', 'Guias', 'Apoios', 'Instalação', 'Equipamentos'];
---

<Layout
  title="Recursos e Artigos sobre Acessibilidade | Vida Acessível"
  description="Guias, informação de preços, apoios do Estado e dicas práticas sobre soluções de acessibilidade residencial em Portugal."
  canonical="/recursos/"
  breadcrumbs={[{ name: 'Início', url: '/' }, { name: 'Recursos', url: '/recursos/' }]}
>
  <Nav />

  <section class="bg-secondary py-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-foreground mb-3">Recursos &amp; Artigos</h1>
        <p class="font-body text-base text-muted-foreground max-w-xl mx-auto">
          Informação clara e honesta sobre soluções de acessibilidade residencial em Portugal — para tomar decisões informadas.
        </p>
      </div>

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 justify-center" id="category-filter">
        {categories.map((cat) => (
          <button
            class="category-btn rounded-full border border-border px-4 py-2 text-sm font-heading font-semibold text-muted-foreground hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-6" id="articles-grid">
        {articles.map((article) => (
          <a
            href={`/recursos/${article.slug}/`}
            class="group bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow article-card"
            data-category={article.data.category}
          >
            <div
              class="h-44 bg-primary/5 flex items-center justify-center"
              data-image-description={`Blog article illustration for: ${article.data.title}, Portuguese accessibility themed, warm editorial photography, WebP`}
            >
              <div class="text-center p-4">
                <span class="inline-block bg-primary/10 text-primary text-xs font-heading font-semibold px-3 py-1 rounded-full">{article.data.category}</span>
              </div>
            </div>
            <div class="p-5">
              <span class="inline-block bg-primary/10 text-primary text-xs font-heading font-semibold px-2.5 py-1 rounded-full mb-3">{article.data.category}</span>
              <h2 class="font-heading font-bold text-base text-foreground mb-2 leading-snug group-hover:text-primary transition-colors">{article.data.title}</h2>
              <p class="font-body text-sm text-muted-foreground mb-4 line-clamp-2">{article.data.description}</p>
              <div class="flex items-center justify-between">
                <time class="font-body text-xs text-muted-foreground">
                  {new Date(article.data.pubDate).toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
                <span class="inline-flex items-center gap-1 font-heading font-semibold text-xs text-primary group-hover:gap-2 transition-all">
                  Ler mais →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      {articles.length === 0 && (
        <div class="text-center py-16">
          <p class="font-body text-muted-foreground">Ainda não há artigos publicados.</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-secondary section-spacing">
    <div class="content-width text-center">
      <h2 class="font-heading font-bold text-2xl text-foreground mb-3">Precisa de ajuda a escolher?</h2>
      <p class="font-body text-base text-muted-foreground mb-6 max-w-md mx-auto">Receba até 3 orçamentos gratuitos de instaladores certificados e compare com toda a tranquilidade.</p>
      <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-8 py-3 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">
        Pedir Orçamento Gratuito
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .bg-cta { background-color: hsl(16 76% 60%); }
  .text-cta-foreground { color: hsl(0 0% 100%); }
  .line-clamp-2 { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .category-btn.active { background-color: hsl(187 100% 22%); color: white; border-color: hsl(187 100% 22%); }
</style>

<script>
  const buttons = document.querySelectorAll('.category-btn');
  const cards = document.querySelectorAll('.article-card');

  // Set "Todos" as active initially
  buttons[0]?.classList.add('active');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const cat = btn.getAttribute('data-category');
      cards.forEach(card => {
        if (cat === 'Todos' || card.getAttribute('data-category') === cat) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
