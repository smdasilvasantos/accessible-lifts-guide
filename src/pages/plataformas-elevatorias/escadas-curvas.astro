---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FaqSection from '../../components/FaqSection.astro';

const faqs = [
  { question: 'Demora muito a fabricar a calha para escadas curvas?', answer: 'Geralmente 2 a 4 semanas após a visita técnica de medição. O processo inclui levantamento topográfico da escada, projeto da calha e fabricação. A instalação em si demora 4 a 8 horas.' },
  { question: 'Qual é a largura mínima de escada?', answer: 'Para plataformas elevatórias, recomenda-se uma largura mínima de escada de 80 cm. Com a plataforma dobrada em repouso, fica ocupados apenas 35-40 cm.' },
  { question: 'É necessário aprovação do condomínio?', answer: 'Em espaços comuns de condomínio, sim. Precisa de aprovação em assembleia de condóminos. O instalador pode ajudar com documentação técnica e apoio no processo.' },
  { question: 'Que manutenção é necessária?', answer: 'Revisão anual recomendada. Os modelos exteriores requerem atenção adicional às vedações e lubrificação das peças móveis.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
---
<Layout
  title="Plataforma Elevatória para Escadas Curvas — Preço e Instalação em Portugal | Vida Acessível"
  description="Para escadas com curvas ou patamares, a plataforma elevatória pode ser equipada com calha feita à medida, adaptando-se a qualquer geometria de escada. Preços de €6.000–€12.000. Compare orçamentos gratuitos de instaladores certificados."
  canonical="/plataformas-elevatorias/escadas-curvas/"
  schemas={[faqSchema]}
>
  <Nav />
  <section class="bg-secondary section-spacing">
    <div class="content-width">
      <nav aria-label="Breadcrumb" class="mb-5"><ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground"><li><a href="/" class="hover:text-foreground">Início</a></li><li>›</li><li><a href="/equipamentos/plataformas-elevatorias/" class="hover:text-foreground">Plataformas Elevatórias</a></li><li>›</li><li><span class="text-foreground font-medium">Plataforma Elevatória para Escadas Curvas</span></li></ol></nav>
      <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-foreground leading-tight mb-5">Plataforma Elevatória para Escadas Curvas — Solução Personalizada</h1>
      <p class="font-body text-base text-muted-foreground leading-relaxed mb-6">Para escadas com curvas ou patamares, a plataforma elevatória pode ser equipada com calha feita à medida, adaptando-se a qualquer geometria de escada.</p>
      <div class="bg-card border border-border rounded-xl inline-flex px-5 py-3 mb-8">
        <p class="font-heading font-bold text-primary text-lg mr-3">€6.000–€12.000</p>
        <p class="font-body text-sm text-muted-foreground self-center">Preço indicativo</p>
      </div>
      <div class="flex gap-3 flex-wrap">
        <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-7 py-3 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">Pedir Orçamento Gratuito</a>
        <a href="/catalogo-gratis/" class="inline-flex items-center rounded-full border border-border px-7 py-3 text-base font-heading font-semibold text-foreground hover:bg-accent transition-colors">Catálogo Grátis</a>
      </div>
    </div>
  </section>
  <FaqSection faqs={faqs} />
  <section class="section-spacing"><div class="content-width text-center">
    <h2 class="font-heading font-bold text-2xl text-foreground mb-4">Compare orçamentos gratuitos</h2>
    <p class="font-body text-base text-muted-foreground mb-6 max-w-md mx-auto">Receba até 3 propostas de instaladores certificados e escolha com confiança.</p>
    <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-8 py-3.5 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">Pedir Orçamento Gratuito</a>
  </div></section>
  <Footer />
</Layout>
<style>.bg-cta { background-color: hsl(16 76% 60%); }.text-cta-foreground { color: hsl(0 0% 100%); }</style>
