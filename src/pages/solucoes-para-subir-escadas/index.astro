---
import Layout from '../../layouts/Layout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import AnimatedIcon from '../../components/icons/AnimatedIcon.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Qual a diferença entre elevador de escadas e plataforma elevatória?", "acceptedAnswer": { "@type": "Answer", "text": "O elevador de escadas transporta a pessoa sentada num assento que desliza ao longo da escada. A plataforma elevatória transporta uma plataforma horizontal onde o utilizador permanece na sua cadeira de rodas. Se não usa cadeira de rodas, a cadeira elevatória é normalmente mais adequada e mais económica." } },
    { "@type": "Question", "name": "Consigo instalar uma solução sem fazer obras em casa?", "acceptedAnswer": { "@type": "Answer", "text": "Na maioria dos casos sim. Tanto os elevadores de escadas como os modelos sem poço instalam-se sem obras de construção civil. Basta uma tomada elétrica standard. Alguns modelos requerem apenas meio dia para a instalação completa." } },
    { "@type": "Question", "name": "A minha escada é muito estreita — há solução?", "acceptedAnswer": { "@type": "Answer", "text": "Provavelmente sim. Existem modelos de elevador de escadas para escadas a partir de 60 cm de largura útil. O assento dobra quando não está em uso, deixando passagem livre." } },
    { "@type": "Question", "name": "Uma pessoa sozinha consegue usar o equipamento com segurança?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Os equipamentos são concebidos para uso autónomo. O comando é simples e o equipamento tem sensores de segurança. A bateria de emergência garante funcionamento mesmo em cortes de energia." } }
  ]
};
---

<Layout
  title="Soluções para Subir Escadas em Casa — Portugal | Vida Acessível"
  description="Dificuldade em subir escadas? Descubra as melhores soluções para mobilidade reduzida em Portugal: elevadores de escadas, plataformas e elevadores residenciais."
  canonical="https://vidaacessivel.pt/solucoes-para-subir-escadas/"
  schema={faqSchema}
  breadcrumbs={[{ name: "Soluções para Subir Escadas", url: "/solucoes-para-subir-escadas/" }]}
>

  <!-- 1. HERO -->
  <section class="bg-secondary py-16 md:py-20">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <nav aria-label="Breadcrumb" class="mb-5">
            <ol class="flex items-center gap-2 text-xs text-muted-foreground">
              <li><a href="/" class="hover:text-primary">Início</a></li>
              <li>/</li>
              <li class="text-foreground font-medium">Soluções para Subir Escadas</li>
            </ol>
          </nav>
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-foreground leading-tight mb-5">
            Se subir escadas está a ficar difícil — a solução existe
          </h1>
          <p class="font-body text-muted-foreground text-lg mb-6 leading-relaxed">
            Cada situação é única. Descubra qual o equipamento mais adequado para si ou para um familiar — sem obras desnecessárias, sem compromisso.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/pedir-orcamento/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-cta text-white font-heading font-bold rounded-full shadow-md hover:shadow-lg transition-all group">
              Pedir Orçamento Gratuito
              <AnimatedIcon name="send" class="w-4 h-4" color="white" />
            </a>
            <a href="/catalogo-gratis/" class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary/5 transition-colors group">
              <AnimatedIcon name="file-text" class="w-4 h-4" color="hsl(var(--primary))" />
              Catálogo Grátis
            </a>
          </div>
        </div>
        <div class="img-placeholder bg-primary/10 rounded-2xl w-full h-[300px] flex items-center justify-center">
          <span class="text-muted-foreground text-sm">Imagem: dificuldade em subir escadas</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NÃO ESTÁ SOZINHO -->
  <section class="py-14 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="flex gap-5">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 mt-1">
          <AnimatedIcon name="heart" class="w-6 h-6" color="hsl(var(--primary))" />
        </div>
        <div>
          <h2 class="font-heading font-bold text-2xl text-foreground mb-4">Não está sozinho</h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">Subir e descer escadas pode tornar-se progressivamente mais difícil — com a idade, após uma cirurgia, com artrose ou simplesmente com o cansaço que vai crescendo. Não é uma questão de fraqueza. É uma questão prática que tem solução.</p>
          <p class="font-body text-muted-foreground leading-relaxed">Para muitas famílias, a conversa começa com hesitação. Preocupações com o custo, com a estética, com a ideia de "obras" em casa — tudo isso é compreensível. A boa notícia é que a maioria dessas preocupações não corresponde à realidade de uma instalação moderna.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SOLUÇÕES POSSÍVEIS -->
  <section class="py-14 bg-secondary">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Qual solução se adapta a si?</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Três categorias de equipamento — cada uma adequada a uma necessidade diferente.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            icon: 'stairs' as const,
            href: "/equipamentos/elevadores-de-escadas/",
            title: "Elevador de Escadas",
            desc: "Ideal se consegue sentar-se e levantar-se de forma autónoma. A solução mais rápida de instalar e a mais económica.",
            items: ["Não usa cadeira de rodas", "Desde 2.500€", "Instalação em 1 dia"],
            tag: "Mais popular"
          },
          {
            icon: 'wheelchair' as const,
            href: "/equipamentos/plataformas-elevatorias/",
            title: "Plataforma Elevatória",
            desc: "Para utilizadores de cadeira de rodas. O utilizador permanece na cadeira durante toda a deslocação.",
            items: ["Ideal para cadeira de rodas", "Desde 4.000€", "Sem sair da cadeira"],
            tag: ""
          },
          {
            icon: 'home' as const,
            href: "/equipamentos/elevadores/",
            title: "Elevador Residencial",
            desc: "Solução permanente para moradia com vários pisos. Discreta, duradoura e valoriza o imóvel.",
            items: ["Solução definitiva", "Desde 8.000€", "Valoriza o imóvel"],
            tag: "Solução permanente"
          },
        ].map(({ icon, href, title, desc, items, tag }) => (
          <a href={href} class="bg-card border border-border rounded-2xl p-6 hover:shadow-lg hover:border-primary/30 transition-all group">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-6 h-6" color="hsl(var(--primary))" />
            </div>
            {tag && <span class="inline-block bg-primary/10 text-primary font-heading text-xs font-semibold px-2.5 py-0.5 rounded-full mb-2">{tag}</span>}
            <h3 class="font-heading font-bold text-lg text-foreground mb-2 group-hover:text-primary transition-colors">{title}</h3>
            <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">{desc}</p>
            <ul class="space-y-1 mb-4">
              {items.map(item => (
                <li class="font-body text-xs text-muted-foreground flex items-center gap-2">
                  <AnimatedIcon name="check-circle" class="w-3.5 h-3.5 shrink-0" color="hsl(var(--primary))" />
                  {item}
                </li>
              ))}
            </ul>
            <span class="inline-flex items-center gap-1 text-primary font-body text-sm font-medium">
              Ver soluções <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. COMO ESCOLHER -->
  <section class="py-14 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl text-foreground mb-6">Como escolher entre as opções</h2>
      <div class="space-y-4">
        {[
          { q: "Consegue sentar-se e levantar-se de forma autónoma?", a: "Se sim → o elevador de escadas é a solução mais rápida e mais económica. Instala-se num dia.", cta: "/equipamentos/elevadores-de-escadas/" },
          { q: "Usa cadeira de rodas?", a: "Se sim → a plataforma elevatória é a solução certa. O utilizador permanece na cadeira durante toda a deslocação.", cta: "/equipamentos/plataformas-elevatorias/" },
          { q: "A casa tem vários pisos e quer uma solução permanente?", a: "Se sim → o elevador residencial valoriza o imóvel e serve a família por décadas.", cta: "/equipamentos/elevadores/" },
        ].map(({ q, a, cta }) => (
          <div class="bg-card border border-border rounded-xl p-5">
            <p class="font-heading font-semibold text-foreground mb-2">{q}</p>
            <p class="font-body text-sm text-muted-foreground mb-2">{a}</p>
            <a href={cta} class="inline-flex items-center gap-1 text-primary font-body text-xs font-medium hover:underline">
              Saber mais <AnimatedIcon name="arrow-right" class="w-3 h-3" color="hsl(var(--primary))" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. PRICE ANCHOR -->
  <section class="py-10 bg-primary/5 border-y border-primary/20">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-xl text-foreground mb-4">Quanto custa aproximadamente</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {[
          { label: "Elevador de escadas", price: "2.500€ – 8.000€", href: "/equipamentos/elevadores-de-escadas/preco/" },
          { label: "Elevador residencial", price: "8.000€ – 25.000€", href: "/equipamentos/elevadores/preco/" },
          { label: "Plataforma elevatória", price: "4.000€ – 12.000€", href: "/equipamentos/plataformas-elevatorias/preco/" },
        ].map(({ label, price, href }) => (
          <div class="bg-card border border-border rounded-xl p-4 group">
            <p class="font-body text-xs text-muted-foreground mb-1">{label}</p>
            <p class="font-heading font-bold text-primary text-lg mb-2">{price}</p>
            <a href={href} class="inline-flex items-center gap-1 text-primary font-body text-xs font-medium hover:underline">
              Ver guia de preços <AnimatedIcon name="arrow-right" class="w-3 h-3" color="hsl(var(--primary))" />
            </a>
          </div>
        ))}
      </div>
      <p class="font-body text-xs text-muted-foreground mt-4">Valores indicativos · instalação incluída · IVA incluído (taxa aplicável)</p>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="py-14 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl text-foreground mb-8">Perguntas frequentes</h2>
      <div class="space-y-3">
        {[
          ["Qual a diferença entre elevador de escadas e plataforma elevatória?", "O elevador de escadas transporta a pessoa sentada num assento. A plataforma elevatória transporta o utilizador na sua própria cadeira de rodas — sem precisar de sair dela. Se não usa cadeira de rodas, a cadeira elevatória é normalmente mais adequada e mais económica."],
          ["Consigo instalar uma solução sem fazer obras em casa?", "Na maioria dos casos sim. Tanto os elevadores de escadas como os modelos sem poço instalam-se sem obras de construção civil. Basta uma tomada elétrica standard nas proximidades."],
          ["A minha escada é muito estreita — há solução?", "Provavelmente sim. Existem modelos para escadas com apenas 60 cm de largura útil. O assento dobra quando não está em uso, deixando a escada livre."],
          ["Uma pessoa sozinha consegue usar o equipamento com segurança?", "Sim. Os equipamentos são concebidos para uso autónomo — comando simples, sensores de segurança e bateria de emergência. Não precisa de depender de ninguém."]
        ].map(([q, a]) => (
          <div class="faq-item border border-border rounded-xl bg-card">
            <button class="faq-btn w-full text-left px-6 py-4 font-heading font-semibold text-foreground flex justify-between items-center gap-4" aria-expanded="false">
              <span>{q}</span>
              <svg class="faq-chevron w-5 h-5 text-primary transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5 text-muted-foreground font-body text-sm leading-relaxed"><p>{a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FORM — framed as "Diga-nos o seu caso" -->
  <section class="py-14 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="text-center mb-8">
        <h2 class="font-heading font-bold text-2xl text-foreground mb-3">Diga-nos o seu caso — encontramos a solução certa</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Receba até 3 orçamentos gratuitos de instaladores certificados. Sem compromisso, ao seu ritmo.</p>
      </div>
      <QuoteForm heading="" subheading="" />
    </div>
  </section>

</Layout>

<script>
document.querySelectorAll('.faq-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const answer = btn.nextElementSibling as HTMLElement;
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    answer.classList.toggle('hidden');
    (btn.querySelector('.faq-chevron') as HTMLElement).style.transform = expanded ? '' : 'rotate(180deg)';
  });
});
</script>
