---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contacto — Vida Acessível | Fale Connosco"
  description="Entre em contacto com o Vida Acessível. Estamos disponíveis para responder às suas dúvidas sobre soluções de acessibilidade em Portugal."
  canonical="/contacto/"
  breadcrumbs={[{ name: 'Início', url: '/' }, { name: 'Contacto', url: '/contacto/' }]}
>
  <Nav />

  <section class="bg-secondary section-spacing">
    <div class="content-width text-center">
      <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-foreground mb-4">
        Fale connosco
      </h1>
      <p class="font-body text-lg text-muted-foreground max-w-xl mx-auto">
        Tem dúvidas sobre equipamentos, instalação ou apoios do Estado? Estamos aqui para ajudar.
      </p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="content-width">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact info -->
        <div>
          <h2 class="font-heading font-bold text-xl text-foreground mb-6">Informações de contacto</h2>
          <div class="space-y-5">
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div>
                <p class="font-heading font-semibold text-sm text-foreground">Email</p>
                <a href="mailto:info@vidaacessivel.pt" class="font-body text-sm text-primary hover:underline">info@vidaacessivel.pt</a>
              </div>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <div>
                <p class="font-heading font-semibold text-sm text-foreground">Horário</p>
                <p class="font-body text-sm text-muted-foreground">Segunda a Sexta, 9h–18h</p>
              </div>
            </div>
          </div>

          <div class="mt-10 bg-secondary rounded-2xl p-6">
            <h3 class="font-heading font-bold text-base text-foreground mb-3">Resposta rápida</h3>
            <p class="font-body text-sm text-muted-foreground mb-4">
              Para receber orçamentos comparativos de instaladores certificados, use o formulário de pedido de orçamento — é mais rápido e gratuito.
            </p>
            <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-5 py-2.5 text-sm font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">
              Pedir Orçamento
            </a>
          </div>
        </div>

        <!-- Contact form -->
        <div>
          <h2 class="font-heading font-bold text-xl text-foreground mb-6">Envie-nos uma mensagem</h2>
          <form id="contact-form" class="space-y-4" novalidate>
            <div>
              <label for="nome" class="block font-body text-sm font-semibold text-foreground mb-1.5">Nome *</label>
              <input type="text" id="nome" name="nome" required placeholder="O seu nome" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <div>
              <label for="email" class="block font-body text-sm font-semibold text-foreground mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required placeholder="o.seu@email.pt" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <div>
              <label for="assunto" class="block font-body text-sm font-semibold text-foreground mb-1.5">Assunto</label>
              <input type="text" id="assunto" name="assunto" placeholder="Dúvida sobre equipamentos..." class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <div>
              <label for="mensagem" class="block font-body text-sm font-semibold text-foreground mb-1.5">Mensagem *</label>
              <textarea id="mensagem" name="mensagem" required rows="5" placeholder="A sua mensagem..." class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 resize-none"></textarea>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="privacidade" name="privacidade" required class="mt-0.5 h-4 w-4 rounded border-border" />
              <label for="privacidade" class="font-body text-xs text-muted-foreground leading-relaxed">
                Aceito a <a href="/politica-de-privacidade/" class="text-primary hover:underline">Política de Privacidade</a> *
              </label>
            </div>
            <div id="contact-error" class="hidden text-sm text-destructive font-body"></div>
            <div id="contact-success" class="hidden bg-primary/10 border border-primary/20 rounded-xl px-4 py-3 text-sm text-primary font-body font-medium"></div>
            <button type="submit" class="w-full rounded-full bg-primary text-primary-foreground px-6 py-3 text-base font-heading font-bold hover:bg-primary/90 transition-all">
              Enviar Mensagem
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .bg-cta { background-color: hsl(16 76% 60%); }
  .text-cta-foreground { color: hsl(0 0% 100%); }
  .shadow-cta\/25 { box-shadow: 0 10px 15px -3px hsl(16 76% 60% / 0.25); }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const errorEl = document.getElementById('contact-error') as HTMLElement;
  const successEl = document.getElementById('contact-success') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries());
    if (!data.nome || !data.email || !data.mensagem) {
      errorEl.textContent = 'Por favor preencha todos os campos obrigatórios.';
      errorEl.classList.remove('hidden');
      return;
    }
    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        successEl.textContent = 'Mensagem enviada com sucesso! Responderemos em breve.';
        successEl.classList.remove('hidden');
        form.reset();
      } else { throw new Error(); }
    } catch {
      errorEl.textContent = 'Erro ao enviar. Por favor tente novamente.';
      errorEl.classList.remove('hidden');
    }
  });
</script>
