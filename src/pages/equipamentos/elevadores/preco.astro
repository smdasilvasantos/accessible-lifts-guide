---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import FaqSection from '../../../components/FaqSection.astro';

const faqs = [
  { question: 'O elevador residencial valoriza a casa?', answer: 'Sim. Um elevador residencial bem instalado pode aumentar o valor de mercado da habitação, especialmente em moradias de 2+ andares. É considerado uma mais-valia permanente.' },
  { question: 'Quanto custa a manutenção anual?', answer: 'A manutenção anual de um elevador residencial custa entre €200 e €600, dependendo do tipo de elevador e do plano de manutenção. Alguns instaladores incluem o primeiro ano de manutenção no preço de instalação.' },
  { question: 'Há apoios para elevadores residenciais?', answer: 'Sim. IVA a 6% aplica-se a elevadores instalados em habitações de pessoas com mobilidade reduzida. O SAPA pode também comparticionar para pessoas com deficiência reconhecida.' },
  { question: 'Quanto tempo dura um elevador residencial?', answer: 'Com manutenção regular, um elevador residencial tem vida útil de 20 a 30 anos ou mais. A durabilidade varia com o tipo de sistema (hidráulico, pneumático, elétrico) e a frequência de uso.' },
];
const offerSchema = { '@context': 'https://schema.org', '@type': 'AggregateOffer', name: 'Elevadores Residenciais', priceCurrency: 'EUR', lowPrice: '8000', highPrice: '35000', description: 'Preços de elevadores residenciais em Portugal' };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
---
<Layout
  title="Quanto Custa um Elevador Residencial em Portugal? Preços 2025 | Vida Acessível"
  description="Preços reais de elevadores residenciais em Portugal (2025): €8.000 a €35.000. Tipos, fatores de custo, IVA 6% e como comparar orçamentos gratuitos."
  canonical="/equipamentos/elevadores/preco/"
  schemas={[offerSchema, faqSchema]}
  breadcrumbs={[{ name: 'Início', url: '/' }, { name: 'Elevadores Residenciais', url: '/equipamentos/elevadores/' }, { name: 'Preço', url: '/equipamentos/elevadores/preco/' }]}
>
  <Nav />
  <section class="bg-secondary section-spacing"><div class="content-width">
    <nav aria-label="Breadcrumb" class="mb-5"><ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground"><li><a href="/" class="hover:text-foreground">Início</a></li><li>›</li><li><a href="/equipamentos/elevadores/" class="hover:text-foreground">Elevadores Residenciais</a></li><li>›</li><li><span class="text-foreground font-medium">Preço</span></li></ol></nav>
    <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-foreground leading-tight mb-5">Quanto custa um elevador residencial em Portugal?</h1>
    <p class="font-body text-lg text-muted-foreground leading-relaxed">Guia completo de preços para 2025, com todos os tipos de elevadores residenciais, fatores que influenciam o custo e apoios do Estado disponíveis.</p>
  </div></section>

  <section class="section-spacing"><div class="content-width">
    <h2 class="font-heading font-bold text-2xl text-foreground mb-6">Preços por tipo de elevador</h2>
    <div class="overflow-x-auto">
      <table class="w-full border border-border rounded-xl overflow-hidden">
        <thead><tr class="bg-secondary">
          <th class="text-left px-5 py-3 font-heading font-bold text-sm text-foreground">Tipo</th>
          <th class="text-left px-5 py-3 font-heading font-bold text-sm text-foreground">Preço</th>
          <th class="text-left px-5 py-3 font-heading font-bold text-sm text-foreground">Andares</th>
        </tr></thead>
        <tbody class="divide-y divide-border">
          {[
            { type: 'Pneumático (vácuo)', price: '€10.000 – €18.000', floors: '1–3' },
            { type: 'Hidráulico compacto', price: '€12.000 – €20.000', floors: '2–3' },
            { type: 'Hidráulico standard', price: '€15.000 – €28.000', floors: '2–4' },
            { type: 'Elétrico com calha', price: '€18.000 – €35.000', floors: '2–5' },
            { type: 'Sem poço (plataforma vertical)', price: '€8.000 – €15.000', floors: '1–2' },
          ].map(row => (<tr class="hover:bg-secondary/50"><td class="px-5 py-3 font-body text-sm text-foreground">{row.type}</td><td class="px-5 py-3 font-heading font-bold text-primary">{row.price}</td><td class="px-5 py-3 font-body text-sm text-muted-foreground">{row.floors}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p class="font-body text-xs text-muted-foreground mt-3">* Preços indicativos com instalação incluída, IVA 6%.</p>
  </div></section>

  <section class="bg-secondary section-spacing"><div class="content-width">
    <h2 class="font-heading font-bold text-2xl text-foreground mb-5">Fatores que influenciam o preço</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {[
        { title: 'Tipo de sistema', desc: 'Pneumático é o mais económico e fácil de instalar. Hidráulico é mais robusto e adequado para mais andares. Elétrico com calha é a solução mais completa.' },
        { title: 'Número de andares', desc: 'Cada andar adicional aumenta o custo: mais estrutura, mais calha, mais paragens.' },
        { title: 'Dimensão da cabine', desc: 'Uma cabine que acomoda uma cadeira de rodas custa mais que uma cabine standard para pessoa em pé.' },
        { title: 'Acabamentos e opções', desc: 'Portas automáticas, espelhos, iluminação especial, chamada de emergência GSM — cada opção adiciona custo.' },
        { title: 'Obras necessárias', desc: 'O custo das obras de civil (criação de poço, abertura de laje) pode acrescentar €2.000 a €8.000 ao orçamento total.' },
        { title: 'Manutenção', desc: 'Inclua no orçamento o contrato de manutenção anual (€200–€600/ano) para manter a segurança e garantia.' },
      ].map(f => (<div class="bg-card border border-border rounded-xl p-4"><h3 class="font-heading font-bold text-sm text-foreground mb-1">{f.title}</h3><p class="font-body text-sm text-muted-foreground">{f.desc}</p></div>))}
    </div>
  </div></section>

  <section class="bg-primary/5 section-spacing border-y border-primary/10"><div class="content-width">
    <h2 class="font-heading font-bold text-2xl text-foreground mb-5">Apoios do Estado</h2>
    <div class="grid sm:grid-cols-3 gap-5">
      {[{ title: 'IVA a 6%', desc: 'Aplicável a elevadores instalados em habitações de pessoas com mobilidade reduzida.' }, { title: 'SAPA', desc: 'Comparticipação para pessoas com deficiência ou incapacidade reconhecida.' }, { title: 'Financiamento', desc: 'Muitos instaladores oferecem planos de pagamento em 12 a 60 meses.' }].map(s => (<div class="bg-card border border-primary/20 rounded-xl p-5"><h3 class="font-heading font-bold text-base text-primary mb-2">{s.title}</h3><p class="font-body text-sm text-muted-foreground">{s.desc}</p></div>))}
    </div>
  </div></section>

  <section class="section-spacing"><div class="content-width text-center">
    <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-4">Receba orçamentos para comparar — grátis</h2>
    <p class="font-body text-base text-muted-foreground mb-8 max-w-md mx-auto">A única forma de saber o preço exato é receber orçamentos personalizados. Compare e escolha com confiança.</p>
    <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-8 py-3.5 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">Pedir Orçamentos Gratuitos</a>
  </div></section>

  <FaqSection faqs={faqs} title="Perguntas frequentes sobre o preço" />
  <Footer />
</Layout>
<style>.bg-cta { background-color: hsl(16 76% 60%); }.text-cta-foreground { color: hsl(0 0% 100%); }</style>
