---
import Layout from '../../../layouts/Layout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import AnimatedIcon from '../../../components/icons/AnimatedIcon.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Quanto custa instalar um elevador residencial em Portugal?", "acceptedAnswer": { "@type": "Answer", "text": "Um elevador residencial em Portugal custa entre 8.000€ e 25.000€, dependendo do número de pisos, da tecnologia escolhida e dos acabamentos. Para 2 pisos com homelift, o preço começa nos 8.500€." } },
    { "@type": "Question", "name": "É preciso licença de construção para instalar um elevador residencial?", "acceptedAnswer": { "@type": "Answer", "text": "Homelifts e plataformas verticais normalmente não requerem licenciamento em habitação unifamiliar. Elevadores convencionais podem necessitar de comunicação prévia. O instalador orienta-o neste processo." } },
    { "@type": "Question", "name": "Qual é o elevador residencial mais barato para moradia?", "acceptedAnswer": { "@type": "Answer", "text": "O homelift hidráulico ou pneumático é geralmente a opção mais económica para moradias com 2 pisos, a partir de 8.000€–9.000€." } },
    { "@type": "Question", "name": "Quanto tempo demora a instalação de um elevador residencial?", "acceptedAnswer": { "@type": "Answer", "text": "Um homelift pneumático instala-se em 1–2 dias sem obras estruturais. Elevadores hidráulicos ou elétricos demoram 3–7 dias. Com obras civis, pode demorar mais." } },
    { "@type": "Question", "name": "Qual a diferença entre elevador hidráulico e elétrico?", "acceptedAnswer": { "@type": "Answer", "text": "O hidráulico é silencioso e não precisa de casa de máquinas. O elétrico MRL é mais eficiente energeticamente e mais rápido. A escolha depende do espaço, pisos e orçamento." } },
    { "@type": "Question", "name": "Um elevador residencial valoriza o imóvel?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Moradias com elevador valorizam tipicamente 5–15% acima de propriedades comparáveis. É um investimento que serve décadas." } }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Elevadores Residenciais em Portugal",
  "description": "Fornecimento e instalação de elevadores residenciais em Portugal. Hidráulico, elétrico MRL e pneumático.",
  "provider": { "@type": "Organization", "name": "Vida Acessível", "url": "https://vidaacessivel.pt" },
  "areaServed": { "@type": "Country", "name": "Portugal" }
};
---

<Layout
  title="Elevadores Residenciais em Portugal — Compare Orçamentos | Vida Acessível"
  description="Elevadores residenciais para moradias em Portugal. Hidráulico, elétrico e pneumático. Preços desde 8.000€. Orçamentos gratuitos de instaladores certificados."
  canonical="https://vidaacessivel.pt/equipamentos/elevadores/"
  schema={[faqSchema, serviceSchema]}
  breadcrumbs={[{ name: "Elevadores Residenciais", url: "/equipamentos/elevadores/" }]}
>

  <!-- 1. HERO — no form -->
  <section class="bg-secondary py-16 md:py-24">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <nav aria-label="Breadcrumb" class="mb-5">
            <ol class="flex items-center gap-2 text-xs text-muted-foreground">
              <li><a href="/" class="hover:text-primary">Início</a></li>
              <li>/</li>
              <li class="text-foreground font-medium">Elevadores Residenciais</li>
            </ol>
          </nav>
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-5">Solução permanente</span>
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl lg:text-5xl text-foreground leading-tight mb-5">
            Elevadores Residenciais em Portugal
          </h1>
          <p class="font-body text-lg text-muted-foreground leading-relaxed mb-6">
            A sua moradia tem dois ou mais pisos e subir escadas já não é fácil? Um elevador residencial moderno instala-se em dias, não requer obras pesadas e serve a família por décadas.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/equipamentos/elevadores/preco/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-cta text-white font-heading font-bold rounded-full shadow-md hover:shadow-lg transition-all group">
              Ver preços
              <AnimatedIcon name="euro" class="w-4 h-4" color="white" />
            </a>
            <a href="/catalogo-gratis/" class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary/5 transition-colors group">
              <AnimatedIcon name="file-text" class="w-4 h-4" color="hsl(var(--primary))" />
              Pedir catálogo grátis
            </a>
          </div>
        </div>
        <div class="img-placeholder bg-primary/10 rounded-2xl w-full h-[340px] flex items-center justify-center">
          <span class="text-muted-foreground text-sm">Imagem: elevador residencial</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. QUICK PRICE ANCHOR -->
  <section class="py-10 bg-primary/5 border-y border-primary/20">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
          <AnimatedIcon name="euro" class="w-6 h-6" color="hsl(var(--primary))" />
        </div>
        <div class="flex-1">
          <p class="font-heading font-bold text-foreground text-sm uppercase tracking-wide mb-1">Quanto custa? — resposta rápida</p>
          <p class="font-body text-muted-foreground">Um elevador residencial em Portugal custa entre <strong class="text-foreground">8.000€ e 25.000€</strong>. Para 2 pisos com homelift, o preço começa nos 8.500€.</p>
        </div>
        <a href="/equipamentos/elevadores/preco/" class="inline-flex items-center gap-1.5 text-primary font-heading font-semibold text-sm whitespace-nowrap hover:underline group shrink-0">
          Ver tabela de preços completa
          <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3. SUB-TYPE CARDS -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Tipos de elevador residencial</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Cada tecnologia tem vantagens distintas. Veja qual se adapta à sua moradia.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { href: "/elevadores-residenciais/hidraulicos/", label: "Hidráulico", desc: "Silencioso e sem casa de máquinas. Ideal para moradias de 2–3 pisos.", price: "Desde 8.000€", tag: "Mais popular" },
          { href: "/elevadores-residenciais/pneumaticos/", label: "Pneumático", desc: "Sem poço, sem obras. Instala em 1–2 dias. Design moderno e minimalista.", price: "Desde 9.000€", tag: "Sem obras" },
          { href: "/elevadores-residenciais/sem-poco/", label: "Sem Poço", desc: "Para moradias onde não é possível criar um poço de elevador.", price: "Desde 8.500€", tag: "" },
          { href: "/elevadores-residenciais/compactos/", label: "Compactos", desc: "Para espaços reduzidos. Cabina compacta, instalação discreta.", price: "Desde 8.000€", tag: "" },
          { href: "/elevadores-residenciais/1-andar/", label: "1 Andar", desc: "Solução específica para subir apenas um piso. A mais económica.", price: "Desde 8.500€", tag: "" },
        ].map(({ href, label, desc, price, tag }) => (
          <a href={href} class="bg-card border border-border rounded-2xl p-6 hover:shadow-lg hover:border-primary/30 transition-all group">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name="home" class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            {tag && <span class="inline-block bg-primary/10 text-primary font-heading text-xs font-semibold px-2.5 py-0.5 rounded-full mb-2">{tag}</span>}
            <h3 class="font-heading font-bold text-lg text-foreground mb-2 group-hover:text-primary transition-colors">{label}</h3>
            <p class="font-body text-sm text-muted-foreground mb-3 leading-relaxed">{desc}</p>
            <p class="font-heading font-semibold text-primary text-sm mb-4">{price}</p>
            <span class="inline-flex items-center gap-1 text-primary font-body text-xs font-medium">
              Saber mais <AnimatedIcon name="arrow-right" class="w-3 h-3" color="hsl(var(--primary))" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS -->
  <section class="py-16 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-10 text-center">Como funciona a instalação</h2>
      <div class="grid md:grid-cols-4 gap-5">
        {[
          { icon: 'tool' as const, step: "1", title: "Visita técnica", desc: "O instalador avalia o espaço e as melhores opções para a sua moradia." },
          { icon: 'settings' as const, step: "2", title: "Proposta à medida", desc: "Recebe proposta com equipamento, prazo e condições de pagamento." },
          { icon: 'zap' as const, step: "3", title: "Instalação", desc: "1–7 dias conforme o modelo e obras necessárias." },
          { icon: 'check-circle' as const, step: "4", title: "Pronto a usar", desc: "Formação incluída. Garantia ativa. Pode usar de imediato." },
        ].map(({ icon, step, title, desc }) => (
          <div class="bg-card border border-border rounded-2xl p-5 group hover:border-primary/30 transition-colors">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                <AnimatedIcon name={icon} class="w-4 h-4" color="hsl(var(--primary))" />
              </div>
              <span class="font-heading font-extrabold text-2xl text-primary/20">{step}</span>
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-1 text-sm">{title}</h3>
            <p class="font-body text-xs text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WHO IT'S FOR -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-10 text-center">Para quem é esta solução?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: 'heart' as const, title: "Para moradias com vários pisos", desc: "Se a vida quotidiana está distribuída por andares e subir escadas já cansa, um elevador muda a qualidade de vida do dia a dia." },
          { icon: 'star' as const, title: "Para valorizar o imóvel", desc: "Moradias com elevador vendem mais rápido e a preços superiores. Um investimento que se reflete no valor da propriedade a longo prazo." },
          { icon: 'shield' as const, title: "Para planear com antecedência", desc: "Instalar enquanto está bem de saúde é mais fácil e mais barato do que fazê-lo em situação de urgência." },
        ].map(({ icon, title, desc }) => (
          <div class="bg-card border border-border rounded-2xl p-6 group hover:border-primary/30 transition-colors">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-2">{title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="py-16 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-8 text-center">Perguntas frequentes</h2>
      <div class="space-y-3">
        {[
          ["Quanto custa instalar um elevador residencial em Portugal?", "Um elevador residencial custa entre 8.000€ e 25.000€. Para 2 pisos com homelift, o preço começa nos 8.500€. Consulte a nossa tabela de preços para mais detalhes."],
          ["É preciso licença de construção?", "Homelifts e plataformas verticais normalmente não requerem licenciamento em habitação unifamiliar. Elevadores convencionais podem precisar de comunicação prévia. O instalador orienta-o."],
          ["Qual é o elevador residencial mais barato?", "O homelift hidráulico ou pneumático para 2 pisos, a partir de 8.000€–9.000€, é geralmente a opção mais acessível."],
          ["Quanto tempo demora a instalação?", "Um homelift pneumático instala-se em 1–2 dias. Elevadores hidráulicos ou elétricos demoram 3–7 dias. Com obras civis, pode demorar mais."],
          ["Qual a diferença entre hidráulico e elétrico?", "O hidráulico é mais silencioso e não precisa de casa de máquinas. O elétrico MRL é mais eficiente e mais rápido. A escolha depende do espaço, pisos e orçamento."],
          ["Um elevador residencial valoriza o imóvel?", "Sim. Moradias com elevador valorizam tipicamente 5–15% acima de propriedades comparáveis — e são mais fáceis de vender."],
        ].map(([q, a]) => (
          <div class="faq-item border border-border rounded-xl bg-card">
            <button class="faq-btn w-full text-left px-6 py-4 font-heading font-semibold text-foreground flex justify-between items-center gap-4" aria-expanded="false">
              <span>{q}</span>
              <svg class="faq-chevron w-5 h-5 text-primary transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5 text-muted-foreground font-body text-sm leading-relaxed"><p>{a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. QUOTE FORM — only here -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="text-center mb-8">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">
          Já sabe o que existe. Agora receba propostas para o seu caso.
        </h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">
          Preencha o formulário — recebe até 3 orçamentos gratuitos de instaladores certificados. Sem compromisso.
        </p>
      </div>
      <QuoteForm heading="" subheading="" />
    </div>
  </section>

  <!-- 8. CATÁLOGO CTA -->
  <section class="py-14 bg-secondary border-t border-border">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center gap-6 bg-card border border-border rounded-2xl p-8">
        <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0">
          <AnimatedIcon name="file-text" class="w-7 h-7" color="hsl(var(--primary))" />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="font-heading font-bold text-xl text-foreground mb-2">Ainda a explorar opções?</h3>
          <p class="font-body text-sm text-muted-foreground">Peça o catálogo gratuito e consulte modelos, dimensões e especificações comodamente em casa — sem pressão.</p>
        </div>
        <a href="/catalogo-gratis/" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary hover:text-white transition-all shrink-0 group">
          <AnimatedIcon name="file-text" class="w-4 h-4" color="currentColor" />
          Pedir catálogo grátis
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
document.querySelectorAll('.faq-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const answer = btn.nextElementSibling as HTMLElement;
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    answer.classList.toggle('hidden');
    (btn.querySelector('.faq-chevron') as HTMLElement).style.transform = expanded ? '' : 'rotate(180deg)';
  });
});
</script>
