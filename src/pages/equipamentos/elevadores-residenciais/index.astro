                Ver guia de preços
              </a>
            </div>
          </div>

          <div class="space-y-4">
            <div class="rounded-2xl bg-secondary px-6 py-5 flex items-center justify-between">
              <div>
                <p class="font-heading text-base font-semibold text-foreground">Plataforma entre pisos</p>
                <p class="text-sm text-foreground/50 mt-0.5">1–2 andares, mínima obra</p>
              </div>
              <div class="text-right">
                <p class="font-heading text-lg font-bold text-cta">€8.000 – €20.000</p>
                <p class="text-xs text-foreground/40">incl. instalação</p>
              </div>
            </div>
            <div class="rounded-2xl bg-secondary px-6 py-5 flex items-center justify-between">
              <div>
                <p class="font-heading text-base font-semibold text-foreground">Elevador em cabine (poço existente)</p>
                <p class="text-sm text-foreground/50 mt-0.5">Aproveitamento de espaço existente</p>
              </div>
              <div class="text-right">
                <p class="font-heading text-lg font-bold text-cta">€12.000 – €25.000</p>
                <p class="text-xs text-foreground/40">incl. instalação</p>
              </div>
            </div>
            <div class="rounded-2xl bg-secondary px-6 py-5 flex items-center justify-between">
              <div>
                <p class="font-heading text-base font-semibold text-foreground">Elevador em cabine (poço novo)</p>
                <p class="text-sm text-foreground/50 mt-0.5">Construção de raiz, maior capacidade</p>
              </div>
              <div class="text-right">
                <p class="font-heading text-lg font-bold text-cta">€18.000 – €40.000</p>
                <p class="text-xs text-foreground/40">incl. instalação</p>
              </div>
            </div>
            <div class="rounded-2xl border border-dashed border-foreground/15 px-6 py-5 flex items-center justify-between">
              <div>
                <p class="font-heading text-base font-semibold text-foreground">Elevador exterior</p>
                <p class="text-sm text-foreground/50 mt-0.5">Fixado na fachada, sem obra interna</p>
              </div>
              <div class="text-right">
                <p class="font-heading text-lg font-bold text-cta">€15.000 – €35.000</p>
                <p class="text-xs text-foreground/40">incl. instalação</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =======================================================
         7. FORMULÁRIO DE ORÇAMENTO
    ======================================================= -->
    <ElevadoresQuoteForm client:load />
    <div class="bg-secondary py-5 text-center border-t border-foreground/8">
      <p class="text-sm font-semibold text-primary">Mais de 2.500 famílias ajudadas em Portugal</p>
      <p class="mt-1 text-xs text-foreground/40">Sem compromisso · 100% Gratuito · Instaladores verificados</p>
    </div>

    <!-- =======================================================
         8. FAQ
    ======================================================= -->
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-3xl px-4 md:px-8">
        <div class="text-center mb-12">
          <h2 class="font-heading text-3xl font-bold text-foreground md:text-4xl">Perguntas frequentes</h2>
          <p class="mt-4 text-base text-foreground/55 max-w-md mx-auto leading-relaxed">
            Respostas às dúvidas mais comuns sobre elevadores residenciais em Portugal.
          </p>
        </div>

        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-border bg-secondary px-6 py-5 open:bg-white open:shadow-card transition-all">
              <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
                <span class="font-heading text-base font-semibold text-foreground">{faq.q}</span>
                <svg
                  class="h-5 w-5 flex-shrink-0 text-foreground/40 transition-transform group-open:rotate-180"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="mt-4 text-base text-foreground/65 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- =======================================================
         9. FINAL CTA
    ======================================================= -->
    <section class="bg-[#1D6954] py-14 md:py-18">
      <div class="mx-auto max-w-3xl px-4 md:px-8 text-center">
        <h2 class="font-heading text-2xl font-bold text-white md:text-3xl mb-4">
          Pronto para ter um elevador em casa?
        </h2>
        <p class="text-base leading-relaxed mb-7 max-w-lg mx-auto" style="color: rgba(255,255,255,0.75);">
          Não precisa de decidir agora. Peça orçamentos, compare propostas e decida quando se sentir pronto. É gratuito e sem qualquer compromisso.
        </p>
        <a
          href="/pedir-orcamento/"
          class="inline-flex items-center rounded-full bg-white px-7 py-3.5 text-base font-bold text-[#1D6954] transition-opacity hover:opacity-90"
        >
          Pedir orçamento gratuito
        </a>
      </div>
    </section>

    <!-- =======================================================
         10. ARTIGOS RELACIONADOS
    ======================================================= -->
    <section class="bg-secondary py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center mb-12">
          <h2 class="font-heading text-3xl font-bold text-foreground md:text-4xl">Guias e recursos úteis</h2>
          <p class="mt-4 text-base text-foreground/55 max-w-md mx-auto leading-relaxed">
            Informação clara e prática para tomar a melhor decisão, ao seu ritmo.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {articles.map((article) => (
            <article>
              <a href={`/recursos/${article.slug}`} class="group block">
                <div
                  class="img-placeholder rounded-2xl overflow-hidden mb-4 shadow-card group-hover:shadow-card-hover transition-shadow"
                  style="background:#e8f0ee; display:flex; align-items:center; justify-content:center; position:relative; width:100%; aspect-ratio:4/3;"
                  data-image-description={article.imageDesc}
                >
                  <span style="position:absolute; top:8px; left:8px; font-size:11px; color:#bbb;">Imagem</span>
                  <span style="font-size:12px; color:#bbb; text-align:center; padding:1rem;">
                    {article.imageCaption}
                  </span>
                </div>
                <p class="text-xs font-bold uppercase tracking-[.06em] text-primary mb-1">{article.category}</p>
                <p class="text-base font-medium text-foreground/70 leading-snug group-hover:text-foreground transition-colors">
                  {article.title}
                </p>
              </a>
            </article>
          ))}
        </div>

        <div class="mt-12 text-center">
          <a
            href="/recursos/"
            class="inline-flex items-center rounded-full border border-foreground/25 px-7 py-3 text-sm font-semibold text-foreground/70 transition-colors hover:border-foreground/50 hover:text-foreground"
          >
            Ver todos os artigos
          </a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter client:load />
