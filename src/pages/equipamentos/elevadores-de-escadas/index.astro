---
import Layout from '../../../layouts/Layout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import AnimatedIcon from '../../../components/icons/AnimatedIcon.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Quanto custa um elevador de escadas em Portugal?", "acceptedAnswer": { "@type": "Answer", "text": "Um elevador de escadas em Portugal custa entre 2.500€ e 8.000€, instalação incluída. Para escadas retas — o caso mais comum — o preço começa nos 2.500€. Para escadas curvas, com carril fabricado à medida, o preço sobe para 4.500€–8.000€." } },
    { "@type": "Question", "name": "É preciso fazer obras para instalar um elevador de escadas?", "acceptedAnswer": { "@type": "Answer", "text": "Na grande maioria dos casos, não. O elevador é fixado diretamente nos degraus ou na parede com suportes específicos, sem qualquer obra de construção civil. Basta ter uma tomada elétrica standard nas proximidades. A escada fica exatamente como estava." } },
    { "@type": "Question", "name": "Quanto tempo demora a instalação?", "acceptedAnswer": { "@type": "Answer", "text": "Para escadas retas, a instalação é concluída num dia. Para escadas curvas, o carril é fabricado à medida em 3–6 semanas e a instalação em casa demora 1–2 dias." } },
    { "@type": "Question", "name": "Um elevador de escadas cabe na minha escada estreita?", "acceptedAnswer": { "@type": "Answer", "text": "Provavelmente sim. Existem modelos compactos para escadas com apenas 60 cm de largura útil. O assento dobra quando não está em uso, deixando a escada livre para outros utilizadores." } },
    { "@type": "Question", "name": "Funciona durante cortes de luz?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Todos os modelos modernos incluem bateria de emergência que garante vários ciclos de funcionamento mesmo sem corrente elétrica. A bateria carrega automaticamente." } },
    { "@type": "Question", "name": "O elevador de escadas pode ser removido se deixar de ser necessário?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. A instalação é totalmente reversível. O carril é fixado com parafusos e pode ser removido sem danificar a escada ou as paredes." } }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Elevadores de Escadas em Portugal",
  "description": "Fornecimento e instalação de elevadores de escadas residenciais em Portugal. Escadas retas, curvas, exteriores e estreitas.",
  "provider": { "@type": "Organization", "name": "Vida Acessível", "url": "https://vidaacessivel.pt" },
  "areaServed": { "@type": "Country", "name": "Portugal" }
};
---

<Layout
  title="Elevadores de Escadas em Portugal — Compare Orçamentos Gratuitos | Vida Acessível"
  description="Elevadores de escadas para escadas retas, curvas, exteriores e estreitas. Preços desde 2.500€. Orçamentos gratuitos de instaladores certificados em Portugal."
  canonical="https://vidaacessivel.pt/equipamentos/elevadores-de-escadas/"
  schema={[faqSchema, serviceSchema]}
  breadcrumbs={[{ name: "Equipamentos", url: "/equipamentos/elevadores-de-escadas/" }, { name: "Elevadores de Escadas", url: "/equipamentos/elevadores-de-escadas/" }]}
>

  <!-- 1. HERO — no form -->
  <section class="bg-secondary py-16 md:py-24">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <nav aria-label="Breadcrumb" class="mb-5">
            <ol class="flex items-center gap-2 text-xs text-muted-foreground">
              <li><a href="/" class="hover:text-primary">Início</a></li>
              <li>/</li>
              <li class="text-foreground font-medium">Elevadores de Escadas</li>
            </ol>
          </nav>
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-5">Mais popular em Portugal</span>
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl lg:text-5xl text-foreground leading-tight mb-5">
            Elevadores de Escadas em Portugal
          </h1>
          <p class="font-body text-lg text-muted-foreground leading-relaxed mb-6">
            Subir e descer escadas está a ficar difícil? Existe uma solução que não precisa de obras, não altera a sua casa e pode ser instalada num único dia.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/equipamentos/elevadores-de-escadas/preco/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-cta text-white font-heading font-bold rounded-full shadow-md hover:shadow-lg transition-all group">
              Ver preços
              <AnimatedIcon name="euro" class="w-4 h-4" color="white" />
            </a>
            <a href="/catalogo-gratis/" class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary/5 transition-colors group">
              <AnimatedIcon name="file-text" class="w-4 h-4" color="hsl(var(--primary))" />
              Pedir catálogo grátis
            </a>
          </div>
        </div>
        <div class="img-placeholder bg-primary/10 rounded-2xl w-full h-[340px] flex items-center justify-center"
             data-image-description="Elevador de escadas moderno e elegante numa casa portuguesa, assento branco, carril metálico fino, escada de madeira, luz natural quente, WebP">
          <span class="text-muted-foreground text-sm">Imagem: elevador de escadas</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. QUICK PRICE ANCHOR — high up -->
  <section class="py-10 bg-primary/5 border-y border-primary/20">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
          <AnimatedIcon name="euro" class="w-6 h-6" color="hsl(var(--primary))" />
        </div>
        <div class="flex-1">
          <p class="font-heading font-bold text-foreground text-sm uppercase tracking-wide mb-1">Quanto custa? — resposta rápida</p>
          <p class="font-body text-muted-foreground">Um elevador de escadas em Portugal custa entre <strong class="text-foreground">2.500€ e 8.000€</strong>. O preço depende do tipo de escada, do modelo e da instalação.</p>
        </div>
        <a href="/equipamentos/elevadores-de-escadas/preco/" class="inline-flex items-center gap-1.5 text-primary font-heading font-semibold text-sm whitespace-nowrap hover:underline group shrink-0">
          Ver tabela de preços completa
          <AnimatedIcon name="arrow-right" class="w-4 h-4" color="hsl(var(--primary))" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3. SUB-TYPE CARDS -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">Escolha o tipo de escada</h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">Cada escada é diferente. Veja qual a solução mais adequada para a sua situação.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { href: "/elevadores-de-escadas/escadas-retas/", label: "Escadas Retas", desc: "A solução mais rápida e mais económica. Instalação em 1 dia.", price: "Desde 2.500€", tag: "Mais comum" },
          { href: "/elevadores-de-escadas/escadas-curvas/", label: "Escadas Curvas", desc: "Carril fabricado à medida para escadas com curvas ou patamares.", price: "Desde 4.500€", tag: "" },
          { href: "/elevadores-de-escadas/escadas-exteriores/", label: "Escadas Exteriores", desc: "Resistente à chuva, sol e variações de temperatura. Proteção IP65.", price: "Desde 3.500€", tag: "" },
          { href: "/elevadores-de-escadas/escadas-estreitas/", label: "Escadas Estreitas", desc: "Modelos compactos para escadas a partir de 60 cm de largura.", price: "Desde 3.000€", tag: "" },
        ].map(({ href, label, desc, price, tag }) => (
          <a href={href} class="bg-card border border-border rounded-2xl p-6 hover:shadow-lg hover:border-primary/30 transition-all group">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name="stairs" class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            {tag && <span class="inline-block bg-primary/10 text-primary font-heading text-xs font-semibold px-2.5 py-0.5 rounded-full mb-2">{tag}</span>}
            <h3 class="font-heading font-bold text-lg text-foreground mb-2 group-hover:text-primary transition-colors">{label}</h3>
            <p class="font-body text-sm text-muted-foreground mb-3 leading-relaxed">{desc}</p>
            <p class="font-heading font-semibold text-primary text-sm mb-4">{price}</p>
            <span class="inline-flex items-center gap-1 text-primary font-body text-xs font-medium">
              Saber mais
              <AnimatedIcon name="arrow-right" class="w-3 h-3" color="hsl(var(--primary))" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS -->
  <section class="py-16 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-10 text-center">Como funciona um elevador de escadas</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: 'tool' as const, title: "Fixação nos degraus", desc: "O carril é aparafusado diretamente nos degraus ou na parede. Sem obras. Sem poços. A escada fica intacta." },
          { icon: 'zap' as const, title: "Motor silencioso", desc: "O assento desliza ao longo do carril com um motor elétrico quase silencioso. Velocidade confortável e suave." },
          { icon: 'shield' as const, title: "Segurança total", desc: "Cinto de segurança, sensores de obstáculo, bateria de emergência. Para em segundos se detetar algo na escada." },
        ].map(({ icon, title, desc }) => (
          <div class="bg-card border border-border rounded-2xl p-6 group hover:border-primary/30 transition-colors">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-2">{title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WHO IT'S FOR -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-10 text-center">Para quem é esta solução?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: 'heart' as const, title: "Para pessoas idosas", desc: "Manter a independência em casa é fundamental. Um elevador de escadas permite continuar a usar todos os andares da casa — sem depender de terceiros." },
          { icon: 'clock' as const, title: "Pós-operação ou recuperação", desc: "Após cirurgia ao joelho, anca ou coluna, as escadas tornam-se temporariamente intransponíveis. O elevador resolve isso no próprio dia da instalação." },
          { icon: 'shield' as const, title: "Prevenção de quedas", desc: "As quedas nas escadas são a principal causa de hospitalização acima dos 65 anos. Um elevador elimina esse risco por completo." },
        ].map(({ icon, title, desc }) => (
          <div class="bg-card border border-border rounded-2xl p-6 group hover:border-primary/30 transition-colors">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-2">{title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="py-16 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-8 text-center">
        Perguntas frequentes
      </h2>
      <div class="space-y-3">
        {[
          ["Quanto custa um elevador de escadas em Portugal?", "Um elevador de escadas custa entre 2.500€ e 8.000€, instalação incluída. Para escadas retas — o caso mais comum — o preço começa nos 2.500€. Para escadas curvas, com carril fabricado à medida, o preço sobe para 4.500€–8.000€. Consulte a nossa tabela de preços completa."],
          ["É preciso fazer obras para instalar um elevador de escadas?", "Na grande maioria dos casos, não. O elevador é fixado diretamente nos degraus ou na parede com suportes específicos, sem qualquer obra de construção civil. Basta ter uma tomada elétrica standard nas proximidades. A escada fica exatamente como estava."],
          ["Quanto tempo demora a instalação?", "Para escadas retas, a instalação é concluída num dia. Para escadas curvas, o carril é fabricado à medida em 3–6 semanas e a instalação em casa demora 1–2 dias."],
          ["Um elevador de escadas cabe na minha escada estreita?", "Provavelmente sim. Existem modelos compactos para escadas com apenas 60 cm de largura útil. O assento dobra quando não está em uso, deixando a escada livre para outros utilizadores."],
          ["Funciona durante cortes de luz?", "Sim. Todos os modelos modernos incluem bateria de emergência que garante vários ciclos de funcionamento mesmo sem corrente elétrica. A bateria carrega automaticamente."],
          ["O elevador pode ser removido se deixar de ser necessário?", "Sim. A instalação é totalmente reversível. O carril é fixado com parafusos e pode ser removido sem danificar a escada ou as paredes."],
        ].map(([q, a]) => (
          <div class="faq-item border border-border rounded-xl bg-card">
            <button class="faq-btn w-full text-left px-6 py-4 font-heading font-semibold text-foreground flex justify-between items-center gap-4" aria-expanded="false">
              <span>{q}</span>
              <svg class="faq-chevron w-5 h-5 text-primary transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5 text-muted-foreground font-body text-sm leading-relaxed"><p>{a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. QUOTE FORM — last, properly framed -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="text-center mb-8">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-3">
          Já sabe o que existe. Agora receba propostas para o seu caso.
        </h2>
        <p class="font-body text-muted-foreground max-w-xl mx-auto">
          Preencha o formulário — recebe até 3 orçamentos gratuitos de instaladores certificados. Sem compromisso.
        </p>
      </div>
      <QuoteForm
        heading=""
        subheading=""
      />
    </div>
  </section>

  <!-- 8. CATÁLOGO CTA -->
  <section class="py-14 bg-secondary border-t border-border">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center gap-6 bg-card border border-border rounded-2xl p-8">
        <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0">
          <AnimatedIcon name="file-text" class="w-7 h-7" color="hsl(var(--primary))" />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="font-heading font-bold text-xl text-foreground mb-2">Ainda a explorar opções?</h3>
          <p class="font-body text-sm text-muted-foreground">Peça o catálogo gratuito e consulte modelos, dimensões e especificações técnicas comodamente em casa — sem pressão.</p>
        </div>
        <a href="/catalogo-gratis/" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-primary text-primary font-heading font-bold rounded-full hover:bg-primary hover:text-white transition-all shrink-0 group">
          <AnimatedIcon name="file-text" class="w-4 h-4" color="currentColor" />
          Pedir catálogo grátis
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
document.querySelectorAll('.faq-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const answer = btn.nextElementSibling as HTMLElement;
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    answer.classList.toggle('hidden');
    (btn.querySelector('.faq-chevron') as HTMLElement).style.transform = expanded ? '' : 'rotate(180deg)';
  });
});
</script>
