---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader';
import SiteFooter from '../../../components/SiteFooter';
import catalogoImg from '../../../assets/catalogo-gratis.png';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto custa um elevador de escadas em Portugal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Um elevador de escadas reto custa entre 2.500€ e 5.000€, instalação incluída. Para escadas curvas, o preço varia entre 6.000€ e 12.000€, pois a calha é fabricada à medida. Para uso exterior, os preços rondam os 4.000€ a 8.000€. Peça orçamentos gratuitos para saber o valor exato para a sua escada."
      }
    },
    {
      "@type": "Question",
      "name": "É necessário fazer obras para instalar um elevador de escadas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Não. A instalação de um elevador de escadas não requer obras de construção civil. A calha é fixada diretamente na escada ou na parede sem necessidade de alterações estruturais. A instalação típica de um modelo reto demora entre 4 a 6 horas."
      }
    },
    {
      "@type": "Question",
      "name": "Quanto tempo demora a instalação de um elevador de escadas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para escadas retas, a instalação demora normalmente 4 a 6 horas. Para escadas curvas, pode demorar 1 a 2 dias, pois a calha é fabricada à medida e requer maior ajuste no local."
      }
    },
    {
      "@type": "Question",
      "name": "Os elevadores de escadas são seguros para idosos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Os modelos modernos incluem cinto de segurança, sensores de obstáculos que param o equipamento automaticamente, controlo por joystick ou telecomando, e assentos ergonómicos. São certificados segundo as normas europeias de segurança (EN 81-40)."
      }
    },
    {
      "@type": "Question",
      "name": "Posso instalar um elevador de escadas numa casa arrendada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, na maioria dos casos. Como a instalação não implica obras permanentes, o equipamento pode ser removido quando necessário. Recomendamos confirmar com o proprietário antes da instalação."
      }
    },
    {
      "@type": "Question",
      "name": "Existem apoios financeiros para comprar um elevador de escadas em Portugal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. O programa de Produtos de Apoio da Segurança Social comparticipa parte do custo de equipamentos de mobilidade para pessoas com deficiência ou mobilidade reduzida. Algumas autarquias também têm apoios locais. Consulte a Segurança Social para verificar a elegibilidade."
      }
    },
    {
      "@type": "Question",
      "name": "Um elevador de escadas funciona em caso de corte de eletricidade?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A maioria dos elevadores de escadas modernos funciona com baterias recarregáveis. Mesmo em caso de corte de energia elétrica, as baterias permitem completar pelo menos uma viagem para colocar o utilizador num lugar seguro."
      }
    }
  ]
};

const articles = [
  {
    slug: "guia-de-compra-elevadores-de-escadas",
    category: "Guias de Compra",
    title: "Guia de Compra de Elevadores de Escadas: Tudo o Que Precisa de Saber",
    imageDesc: "Close-up of a person's hands holding a printed guide booklet about stairlifts, sitting at a warm wooden kitchen table in a Portuguese home. Soft natural light. Sony A7R IV, 35mm f/2.0. WebP format.",
    imageCaption: "Guia impresso sobre elevadores de escadas",
  },
  {
    slug: "apoios-aquisicao-equipamentos-mobilidade",
    category: "Apoios e Legislação",
    title: "Apoios para a Aquisição de Equipamentos de Mobilidade em Portugal",
    imageDesc: "An older Portuguese couple reviewing paperwork at a kitchen table, looking relieved and hopeful. Warm natural light, ceramic tiles on the wall. Sony A7R IV, 35mm f/2.0. WebP format.",
    imageCaption: "Casal a analisar apoios financeiros para equipamentos de mobilidade",
  },
  {
    slug: "como-funciona-elevador-de-escadas",
    category: "Elevadores de Escadas",
    title: "Como Funciona um Elevador de Escadas?",
    imageDesc: "Detail shot of a stairlift rail mechanism on a wooden staircase in a traditional Portuguese home. Warm interior lighting, terracotta accents, natural wood grain. Sony A7R IV, 35mm f/2.0. WebP format.",
    imageCaption: "Mecanismo de calha de elevador de escadas",
  },
];

const faqs = [
  {
    q: "Quanto custa um elevador de escadas em Portugal?",
    a: "Um elevador de escadas reto custa entre 2.500€ e 5.000€, instalação incluída. Para escadas curvas, o preço varia entre 6.000€ e 12.000€, pois a calha é fabricada à medida. Para uso exterior, os preços rondam os 4.000€ a 8.000€. Peça orçamentos gratuitos para saber o valor exato para a sua escada.",
  },
  {
    q: "É necessário fazer obras para instalar um elevador de escadas?",
    a: "Não. A instalação não requer obras de construção civil. A calha é fixada diretamente na escada ou na parede sem alterações estruturais. A instalação típica de um modelo reto demora 4 a 6 horas.",
  },
  {
    q: "Quanto tempo demora a instalação?",
    a: "Para escadas retas, normalmente 4 a 6 horas. Para escadas curvas, pode demorar 1 a 2 dias, pois a calha é fabricada à medida e requer maior ajuste.",
  },
  {
    q: "Os elevadores de escadas são seguros para idosos?",
    a: "Sim. Os modelos modernos incluem cinto de segurança, sensores de obstáculos, controlo por joystick ou telecomando e assentos ergonómicos. São certificados segundo normas europeias de segurança (EN 81-40).",
  },
  {
    q: "Posso instalar num andar arrendado?",
    a: "Sim, na maioria dos casos. Como a instalação não implica obras permanentes, o equipamento pode ser removido. Recomendamos confirmar com o proprietário antes de avançar.",
  },
  {
    q: "Existem apoios financeiros para comprar um elevador de escadas?",
    a: "Sim. O programa de Produtos de Apoio da Segurança Social comparticipa parte do custo para pessoas com deficiência ou mobilidade reduzida. Algumas autarquias também têm apoios locais. Consulte a Segurança Social para verificar elegibilidade.",
  },
  {
    q: "Funciona em caso de corte de eletricidade?",
    a: "A maioria dos modelos modernos funciona com baterias recarregáveis. Em caso de corte de energia, as baterias permitem completar pelo menos uma viagem para colocar o utilizador num lugar seguro.",
  },
