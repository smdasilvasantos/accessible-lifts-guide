---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import FaqSection from '../../../components/FaqSection.astro';

const faqs = [
  {
    question: 'Quanto custa um elevador de escadas em Portugal?',
    answer: 'O preço de um elevador de escadas em Portugal varia entre €2.500 e €9.000, dependendo do tipo de escada (reta ou curva), da marca e das funcionalidades opcionais. As escadas retas são mais económicas; as curvas requerem calhas feitas à medida e custam mais. A instalação está normalmente incluída no preço.',
  },
  {
    question: 'É necessário fazer obras para instalar um elevador de escadas?',
    answer: 'Não. Esta é uma das grandes vantagens dos elevadores de escadas: instalam-se na própria escada, sem necessidade de obras estruturais. A calha é fixada nos degraus ou na parede, e todo o processo demora geralmente um dia. A escada continua utilizável pelas restantes pessoas da casa.',
  },
  {
    question: 'O elevador de escadas serve para escadas curvas?',
    answer: 'Sim. Existem modelos específicos para escadas curvas, com patamares ou em L. Nestes casos, a calha é fabricada à medida para a geometria exata da escada. O custo é mais elevado do que para escadas retas, mas a solução é igualmente eficaz e segura.',
  },
  {
    question: 'É seguro usar um elevador de escadas?',
    answer: 'Sim. Os elevadores de escadas modernos têm múltiplos sistemas de segurança: cinto de segurança, sensores de obstáculos, travões automáticos em caso de falha elétrica e baterias que permitem funcionar mesmo em caso de corte de corrente. São certificados pela norma europeia EN 81-40.',
  },
  {
    question: 'Posso instalar o elevador de escadas no exterior?',
    answer: 'Sim. Existem modelos especificamente concebidos para uso exterior, com proteção contra chuva, UV e variações de temperatura. São ideais para casas com escadas de entrada ou jardins com desníveis.',
  },
  {
    question: 'Existe algum apoio do Estado para comprar um elevador de escadas?',
    answer: 'Sim. Os equipamentos de apoio à mobilidade beneficiam de IVA reduzido a 6% em Portugal. Além disso, pode candidatar-se ao SAPA (Sistema de Atribuição de Produtos de Apoio) se tiver incapacidade reconhecida. Algumas câmaras municipais e seguradoras também oferecem apoios adicionais.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Elevadores de Escadas',
  description: 'Instalação de elevadores de escadas residenciais em Portugal. Modelos para escadas retas, curvas, exteriores e estreitas.',
  provider: { '@type': 'Organization', name: 'Vida Acessível' },
  areaServed: { '@type': 'Country', name: 'Portugal' },
  serviceType: 'Acessibilidade Residencial',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout
  title="Elevadores de Escadas — Preços, Modelos e Instalação em Portugal | Vida Acessível"
  description="Tudo sobre elevadores de escadas em Portugal: tipos, preços (€2.500–€9.000), instalação e como obter orçamentos gratuitos de instaladores certificados."
  canonical="/equipamentos/elevadores-de-escadas/"
  schemas={[serviceSchema, faqSchema]}
  breadcrumbs={[{ name: 'Início', url: '/' }, { name: 'Equipamentos', url: '/equipamentos/elevadores-de-escadas/' }, { name: 'Elevadores de Escadas', url: '/equipamentos/elevadores-de-escadas/' }]}
>
  <Nav />

  <!-- HERO -->
  <section class="bg-secondary overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8 items-center min-h-[520px] py-12">
        <div class="order-2 md:order-1">
          <nav aria-label="Breadcrumb" class="mb-5">
            <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
              <li><a href="/" class="hover:text-foreground">Início</a></li>
              <li aria-hidden="true">›</li>
              <li><span class="text-foreground">Elevadores de Escadas</span></li>
            </ol>
          </nav>
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-5">Equipamentos</span>
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl lg:text-5xl text-foreground leading-tight mb-5">
            Elevadores de escadas: soluções para todos os tipos de escada
          </h1>
          <p class="font-body text-lg text-muted-foreground leading-relaxed mb-8 max-w-lg">
            Subir e descer escadas com mobilidade reduzida deixa de ser um problema. Compare orçamentos gratuitos de instaladores certificados em Portugal.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/pedir-orcamento/" class="inline-flex items-center rounded-full bg-cta text-cta-foreground px-7 py-3 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">
              Pedir Orçamento Gratuito
            </a>
            <a href="/catalogo-gratis/" class="inline-flex items-center rounded-full border border-border bg-background px-7 py-3 text-base font-heading font-semibold text-foreground hover:bg-accent transition-colors">
              Catálogo Grátis
            </a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <div
            class="rounded-2xl overflow-hidden shadow-2xl shadow-primary/10 h-[320px] md:h-[400px] bg-primary/5 flex items-center justify-center"
            data-image-description="Modern stairlift installed on a curved wooden residential staircase in a traditional Portuguese home, warm lighting, elderly couple looking satisfied, Sony A7R IV photography, warm tones, WebP"
          >
            <div class="text-center p-8">
              <div class="text-5xl mb-3">🪜</div>
              <p class="font-heading font-semibold text-primary text-sm">Elevador de escadas</p>
              <p class="font-body text-xs text-muted-foreground mt-1">Imagem a ser gerada</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INLINE QUOTE FORM -->
  <section class="section-spacing bg-primary/5 border-y border-primary/10">
    <div class="content-width">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="font-heading font-bold text-2xl text-foreground mb-3">Peça orçamentos gratuitos</h2>
          <p class="font-body text-base text-muted-foreground mb-4">Compare até 3 propostas de instaladores certificados. Gratuito e sem compromisso.</p>
          <div class="space-y-2">
            {['Resposta em 48 horas', 'Parceiros verificados em todo Portugal', 'Sem custos nem compromisso'].map((t) => (
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="font-body text-sm text-foreground">{t}</span>
              </div>
            ))}
          </div>
        </div>
        <form id="hub-form" class="space-y-3" novalidate>
          <div class="grid grid-cols-2 gap-3">
            <input type="text" name="nome" required placeholder="Nome *" class="rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body focus:outline-none focus:ring-2 focus:ring-primary/40" />
            <input type="tel" name="telefone" required placeholder="Telefone *" class="rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </div>
          <input type="email" name="email" required placeholder="Email *" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body focus:outline-none focus:ring-2 focus:ring-primary/40" />
          <input type="hidden" name="equipamento" value="elevador-escadas" />
          <div class="flex items-start gap-2">
            <input type="checkbox" id="priv-hub" name="privacidade" required class="mt-0.5 h-4 w-4 rounded border-border" />
            <label for="priv-hub" class="font-body text-xs text-muted-foreground">Aceito a <a href="/politica-de-privacidade/" class="text-primary hover:underline">Política de Privacidade</a> *</label>
          </div>
          <div id="hub-error" class="hidden text-xs text-destructive"></div>
          <div id="hub-success" class="hidden bg-primary/10 border border-primary/20 rounded-xl px-3 py-2 text-xs text-primary font-medium"></div>
          <button type="submit" class="w-full rounded-full bg-cta text-cta-foreground px-6 py-3 text-sm font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">
            Pedir Orçamento Gratuito
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- SUB-TYPE CARDS -->
  <section class="section-spacing">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-4">Tipos de elevadores de escadas</h2>
      <p class="font-body text-base text-muted-foreground mb-10 max-w-2xl">Cada escada é diferente. Conheça os modelos disponíveis e encontre a solução adequada à sua situação.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { href: '/elevadores-de-escadas/escadas-retas/', title: 'Escadas Retas', desc: 'A solução mais económica. Instalação rápida, num único lance de escadas.', icon: '↑' },
          { href: '/elevadores-de-escadas/escadas-curvas/', title: 'Escadas Curvas', desc: 'Calha feita à medida para escadas em L, U ou com patamares.', icon: '↪' },
          { href: '/elevadores-de-escadas/escadas-exteriores/', title: 'Escadas Exteriores', desc: 'Modelos resistentes às condições climáticas para uso ao ar livre.', icon: '🌧️' },
          { href: '/elevadores-de-escadas/escadas-estreitas/', title: 'Escadas Estreitas', desc: 'Soluções compactas para escadas com largura reduzida.', icon: '⟺' },
        ].map((sub) => (
          <a href={sub.href} class="group bg-card border border-border rounded-2xl p-5 hover:shadow-lg hover:border-primary/30 transition-all">
            <div class="text-3xl mb-3">{sub.icon}</div>
            <h3 class="font-heading font-bold text-base text-foreground mb-2 group-hover:text-primary transition-colors">{sub.title}</h3>
            <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">{sub.desc}</p>
            <span class="inline-flex items-center gap-1 font-heading font-semibold text-sm text-primary group-hover:gap-2 transition-all">
              Saber mais
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EDUCATIONAL CONTENT -->
  <section class="bg-secondary section-spacing">
    <div class="content-width">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-5">O que é um elevador de escadas?</h2>
          <p class="font-body text-base text-muted-foreground leading-relaxed mb-4">
            Um elevador de escadas — também chamado cadeira de escadas ou cadeira elevatória — é um equipamento que se instala na própria escada e permite que pessoas com mobilidade reduzida subam e desçam sem esforço físico.
          </p>
          <p class="font-body text-base text-muted-foreground leading-relaxed mb-4">
            O utilizador senta-se na cadeira, que desliza ao longo de uma calha fixada nos degraus ou na parede. O processo é simples, silencioso e seguro.
          </p>
          <h3 class="font-heading font-bold text-lg text-foreground mb-3 mt-6">Para quem é indicado?</h3>
          <ul class="space-y-2">
            {[
              'Pessoas idosas com dificuldade em subir escadas',
              'Pessoas com problemas articulares, de joelhos ou cadeira de rodas',
              'Pessoas em recuperação pós-operatória',
              'Pessoas com doenças crónicas que afetam a mobilidade',
            ].map((item) => (
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary flex-shrink-0 mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="font-body text-sm text-foreground">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-heading font-bold text-xl text-foreground mb-5">Como funciona a instalação?</h3>
          <div class="space-y-5">
            {[
              { n: '1', title: 'Visita técnica', desc: 'Um técnico avalia a escada e tira as medidas necessárias para dimensionar a calha.' },
              { n: '2', title: 'Fabricação da calha', desc: 'Para escadas curvas, a calha é fabricada à medida. Para escadas retas, é adaptada in loco.' },
              { n: '3', title: 'Instalação', desc: 'A instalação demora normalmente entre 3 a 8 horas, sem obras ou danos na escada.' },
              { n: '4', title: 'Formação e testes', desc: 'O técnico explica o funcionamento e testa todos os sistemas de segurança.' },
            ].map((step) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-primary-foreground font-heading font-bold text-sm">{step.n}</div>
                <div>
                  <p class="font-heading font-semibold text-sm text-foreground mb-1">{step.title}</p>
                  <p class="font-body text-sm text-muted-foreground">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICE SECTION -->
  <section id="preco" class="section-spacing">
    <div class="content-width">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-5">Preço dos elevadores de escadas</h2>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        {[
          { type: 'Escadas retas', range: '€2.500 – €4.500' },
          { type: 'Escadas curvas', range: '€5.000 – €9.000' },
          { type: 'Escadas exteriores', range: '€3.500 – €6.500' },
          { type: 'Escadas estreitas', range: '€2.800 – €5.000' },
        ].map((item) => (
          <div class="flex items-center justify-between bg-secondary rounded-xl px-5 py-4">
            <span class="font-body text-sm text-foreground">{item.type}</span>
            <span class="font-heading font-bold text-primary">{item.range}</span>
          </div>
        ))}
      </div>
      <p class="font-body text-sm text-muted-foreground mb-5">
        Preços indicativos com instalação incluída. O custo final depende da marca, modelo e funcionalidades. IVA 6% aplicável.
      </p>
      <a href="/equipamentos/elevadores-de-escadas/preco/" class="inline-flex items-center gap-2 font-heading font-semibold text-sm text-primary hover:gap-3 transition-all">
        Ver guia completo de preços
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </section>

  <!-- FAQs -->
  <FaqSection faqs={faqs} title="Perguntas frequentes sobre elevadores de escadas" />

  <!-- CATALOG CTA -->
  <section class="bg-primary/5 section-spacing border-y border-primary/10">
    <div class="content-width text-center">
      <h2 class="font-heading font-bold text-2xl text-foreground mb-3">Receba o catálogo gratuito</h2>
      <p class="font-body text-base text-muted-foreground mb-6 max-w-md mx-auto">Conheça todos os modelos disponíveis no mercado com preços, especificações e guias de instalação.</p>
      <a href="/catalogo-gratis/" class="inline-flex items-center rounded-full border border-primary text-primary px-8 py-3 text-base font-heading font-semibold hover:bg-primary hover:text-primary-foreground transition-colors">
        Pedir Catálogo Gratuito
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .bg-cta { background-color: hsl(16 76% 60%); }
  .text-cta-foreground { color: hsl(0 0% 100%); }
  .shadow-cta\/25 { box-shadow: 0 10px 15px -3px hsl(16 76% 60% / 0.25); }
</style>

<script>
  const form = document.getElementById('hub-form') as HTMLFormElement;
  const errorEl = document.getElementById('hub-error') as HTMLElement;
  const successEl = document.getElementById('hub-success') as HTMLElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden'); successEl.classList.add('hidden');
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries());
    if (!data.nome || !data.email || !data.telefone || !data.privacidade) {
      errorEl.textContent = 'Por favor preencha todos os campos obrigatórios.';
      errorEl.classList.remove('hidden'); return;
    }
    try {
      const res = await fetch('/api/orcamento', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) { successEl.textContent = 'Pedido enviado! Receberá as propostas em breve.'; successEl.classList.remove('hidden'); form.reset(); }
      else { throw new Error(); }
    } catch { errorEl.textContent = 'Erro ao enviar. Por favor tente novamente.'; errorEl.classList.remove('hidden'); }
  });
</script>
