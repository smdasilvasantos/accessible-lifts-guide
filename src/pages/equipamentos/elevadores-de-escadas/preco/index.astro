---
import Layout from '../../../../layouts/Layout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import AnimatedIcon from '../../../../components/icons/AnimatedIcon.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Quanto custa um elevador de escadas em Portugal?", "acceptedAnswer": { "@type": "Answer", "text": "Um elevador de escadas em Portugal custa entre 2.500€ e 8.000€, instalação incluída. Para escadas retas — o caso mais comum — o preço começa nos 2.500€. Para escadas curvas, com carril fabricado à medida, o preço situa-se entre 4.500€ e 8.000€." } },
    { "@type": "Question", "name": "O preço do elevador de escadas inclui a instalação?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Os orçamentos dos instaladores parceiros incluem sempre o equipamento, transporte, instalação completa, formação de utilização e garantia. Não há custos ocultos." } },
    { "@type": "Question", "name": "Quanto tempo demora a instalação?", "acceptedAnswer": { "@type": "Answer", "text": "Para escadas retas, a instalação é concluída num dia. Para escadas curvas, o carril é fabricado à medida em 3–6 semanas e a instalação em casa demora 1–2 dias." } },
    { "@type": "Question", "name": "É preciso fazer obras para instalar um elevador de escadas?", "acceptedAnswer": { "@type": "Answer", "text": "Na maioria dos casos, não. O elevador é fixado diretamente nos degraus ou na parede sem obras de construção civil. Basta ter uma tomada elétrica standard nas proximidades." } },
    { "@type": "Question", "name": "Posso instalar em escadas estreitas?", "acceptedAnswer": { "@type": "Answer", "text": "Provavelmente sim. Existem modelos compactos para escadas com apenas 60 cm de largura útil." } },
    { "@type": "Question", "name": "Existem apoios do Estado para comprar um elevador de escadas?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. O SAPA (Segurança Social) apoia a aquisição para pessoas com deficiência reconhecida. Aplica-se também IVA a 6% em habitação própria e permanente, e muitos instaladores oferecem financiamento sem juros." } }
  ]
};

const aggregateOfferSchema = {
  "@context": "https://schema.org",
  "@type": "AggregateOffer",
  "name": "Elevadores de Escadas em Portugal — Preços 2025",
  "priceCurrency": "EUR",
  "lowPrice": "2500",
  "highPrice": "8000",
  "offerCount": "4",
  "description": "Preços de elevadores de escadas instalados em Portugal, incluindo escadas retas, curvas, exteriores e estreitas. IVA incluído, instalação incluída."
};
---

<Layout
  title="Quanto Custa um Elevador de Escadas em Portugal? Preços 2025 | Vida Acessível"
  description="Guia completo de preços de elevadores de escadas em Portugal 2025. Escadas retas desde 2.500€, curvas desde 4.500€. Compare orçamentos gratuitos de instaladores certificados."
  canonical="https://vidaacessivel.pt/equipamentos/elevadores-de-escadas/preco/"
  schema={[faqSchema, aggregateOfferSchema]}
  breadcrumbs={[
    { name: "Elevadores de Escadas", url: "/equipamentos/elevadores-de-escadas/" },
    { name: "Preço", url: "/equipamentos/elevadores-de-escadas/preco/" }
  ]}
>

  <nav aria-label="Breadcrumb" class="py-3 max-w-7xl mx-auto px-4 md:px-8">
    <ol class="flex items-center gap-2 text-xs text-muted-foreground">
      <li><a href="/" class="hover:text-primary">Início</a></li><li>/</li>
      <li><a href="/equipamentos/elevadores-de-escadas/" class="hover:text-primary">Elevadores de Escadas</a></li><li>/</li>
      <li class="text-foreground font-medium">Preço</li>
    </ol>
  </nav>

  <!-- HERO + QUICK ANSWER -->
  <section class="bg-secondary py-14 md:py-20">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-5">Guia de Preços 2025</span>
      <h1 class="font-heading font-extrabold text-3xl md:text-5xl text-foreground leading-tight mb-5">
        Quanto custa um elevador de escadas em Portugal?
      </h1>
      <p class="font-body text-muted-foreground text-lg mb-10 max-w-2xl mx-auto">Preços 2025: por tipo de escada, fatores de custo, apoios do Estado e o que está incluído no orçamento.</p>

      <!-- Quick answer box -->
      <div class="bg-card border-2 border-primary/20 rounded-2xl p-6 md:p-8 max-w-2xl mx-auto text-left">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
            <AnimatedIcon name="euro" class="w-5 h-5" color="hsl(var(--primary))" />
          </div>
          <span class="font-heading font-bold text-foreground">Resposta rápida</span>
        </div>
        <p class="font-body text-muted-foreground mb-4">Um elevador de escadas em Portugal custa entre <strong class="text-foreground text-lg">2.500€ e 8.000€</strong>. Para escadas retas — o caso mais comum — o preço começa nos 2.500€.</p>
        <ul class="space-y-2 mb-4">
          {[
            ["Escadas retas", "desde 2.500€"],
            ["Escadas curvas", "desde 4.500€"],
            ["Escadas exteriores", "desde 3.500€"],
            ["Escadas estreitas", "desde 3.000€"],
          ].map(([tipo, preco]) => (
            <li class="flex items-center justify-between text-sm font-body">
              <span class="flex items-center gap-2 text-foreground/80">
                <span class="text-primary font-bold">•</span> {tipo}
              </span>
              <span class="font-heading font-semibold text-primary">{preco}</span>
            </li>
          ))}
        </ul>
        <p class="font-body text-xs text-muted-foreground">IVA incluído (taxa aplicável) · instalação incluída · valores indicativos</p>
      </div>
    </div>
  </section>

  <!-- O QUE INFLUENCIA O PREÇO -->
  <section class="py-14 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-8">O que influencia o preço</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {[
          { icon: 'stairs' as const, title: "Tipo de escada", desc: "Escada reta = preço base. Curva = carril fabricado à medida = custo adicional de 2.000€ a 5.000€. É o fator com maior impacto no preço final." },
          { icon: 'arrow-up' as const, title: "Comprimento do percurso", desc: "Mais degraus = carril mais longo = mais custo. Cada metro adicional de carril acrescenta valor ao orçamento." },
          { icon: 'settings' as const, title: "Marca e modelo", desc: "Modelos compactos e básicos têm preços inferiores. Modelos premium com assento giratório motorizado ou comando remoto têm custo superior." },
          { icon: 'tool' as const, title: "Trabalho de instalação", desc: "Em casas antigas, paredes de pedra ou espaços muito apertados, o custo de mão-de-obra pode ser superior." },
        ].map(({ icon, title, desc }) => (
          <div class="flex gap-4 bg-card border border-border rounded-2xl p-6 group hover:border-primary/30 transition-colors">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <div>
              <h3 class="font-heading font-semibold text-foreground mb-1">{title}</h3>
              <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TABELA DE PREÇOS -->
  <section class="py-14 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-2">Tabela de preços por tipo de escada</h2>
      <p class="font-body text-muted-foreground mb-8 text-sm">Valores indicativos · IVA incluído · instalação incluída</p>
      <div class="overflow-x-auto rounded-2xl border border-border bg-card">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-secondary border-b border-border">
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Tipo de escada</th>
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Preço indicativo</th>
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Instalação</th>
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Observações</th>
            </tr>
          </thead>
          <tbody>
            {[
              { tipo: "Escadas Retas", preco: "2.500€ – 4.500€", inst: "1 dia", obs: "Mais comum, instalação mais rápida", href: "/elevadores-de-escadas/escadas-retas/" },
              { tipo: "Escadas Curvas", preco: "4.500€ – 8.000€", inst: "1–2 dias", obs: "Carril fabricado à medida (3–6 sem.)", href: "/elevadores-de-escadas/escadas-curvas/" },
              { tipo: "Escadas Exteriores", preco: "3.500€ – 6.000€", inst: "1–2 dias", obs: "Resistente ao clima, proteção IP65", href: "/elevadores-de-escadas/escadas-exteriores/" },
              { tipo: "Escadas Estreitas", preco: "3.000€ – 5.500€", inst: "1 dia", obs: "Modelos compactos, a partir de 60 cm", href: "/elevadores-de-escadas/escadas-estreitas/" },
            ].map((row, i) => (
              <tr class={i % 2 === 1 ? 'bg-secondary/40' : ''}>
                <td class="px-5 py-3.5 border-b border-border font-body text-foreground font-medium">
                  <a href={row.href} class="hover:text-primary transition-colors">{row.tipo}</a>
                </td>
                <td class="px-5 py-3.5 border-b border-border font-heading font-semibold text-primary">{row.preco}</td>
                <td class="px-5 py-3.5 border-b border-border font-body text-muted-foreground">{row.inst}</td>
                <td class="px-5 py-3.5 border-b border-border font-body text-muted-foreground text-xs">{row.obs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="font-heading font-bold text-2xl text-foreground mt-12 mb-2">Custos adicionais a considerar</h2>
      <p class="font-body text-muted-foreground mb-6 text-sm">Custos recorrentes após a compra</p>
      <div class="overflow-x-auto rounded-2xl border border-border bg-card">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-secondary border-b border-border">
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Componente</th>
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Custo estimado</th>
              <th class="text-left px-5 py-4 font-heading text-foreground font-semibold">Periodicidade</th>
            </tr>
          </thead>
          <tbody>
            {[
              ["Manutenção preventiva", "150€ – 300€", "Anual (opcional*)"],
              ["Consumo elétrico", "20€ – 50€", "Anual"],
              ["Garantia alargada", "200€ – 400€", "Opcional"],
            ].map(([comp, custo, per], i) => (
              <tr class={i % 2 === 1 ? 'bg-secondary/40' : ''}>
                <td class="px-5 py-3.5 border-b border-border font-body text-foreground">{comp}</td>
                <td class="px-5 py-3.5 border-b border-border font-heading font-semibold text-foreground">{custo}</td>
                <td class="px-5 py-3.5 border-b border-border font-body text-muted-foreground">{per}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="font-body text-xs text-muted-foreground mt-3">* Os elevadores de escadas residenciais <strong>não são obrigados</strong> a contrato de manutenção anual (ao contrário dos elevadores convencionais). A manutenção é recomendada mas opcional.</p>
    </div>
  </section>

  <!-- APOIOS À COMPRA -->
  <section class="py-14 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-8">Apoios à compra que reduzem o custo</h2>
      <div class="space-y-4">
        {[
          { icon: 'euro' as const, title: "IVA a 6% (em vez de 23%)", desc: "A instalação em habitação própria e permanente beneficia de IVA reduzido a 6%. Num equipamento de 4.000€, a poupança é de cerca de 680€. Confirme sempre com o instalador antes de encomendar." },
          { icon: 'shield' as const, title: "SAPA — Segurança Social", desc: "O SAPA (Sistema de Atribuição de Produtos de Apoio) apoia a aquisição de ajudas técnicas para pessoas com deficiência reconhecida. O valor depende do grau de incapacidade e situação económica. A candidatura é feita no Centro Distrital da Segurança Social." },
          { icon: 'check-circle' as const, title: "Financiamento sem juros", desc: "A maioria dos instaladores parceiros oferece planos de pagamento em prestações de 12 a 48 meses sem juros, tornando o investimento mais acessível mensalmente." },
        ].map(({ icon, title, desc }) => (
          <div class="flex gap-4 bg-primary/5 border border-primary/20 rounded-2xl p-6 group">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <div>
              <h3 class="font-heading font-semibold text-foreground mb-1">{title}</h3>
              <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VALE A PENA? -->
  <section class="py-14 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-8">Vale a pena instalar um elevador de escadas?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: 'heart' as const, title: "Autonomia em casa", desc: "Mantém a independência de movimento — sem depender de terceiros para subir e descer as escadas todos os dias." },
          { icon: 'shield' as const, title: "Prevenção de quedas", desc: "As quedas nas escadas são a principal causa de hospitalização acima dos 65 anos. Um elevador elimina esse risco por completo." },
          { icon: 'home' as const, title: "Sem obras permanentes", desc: "Desmontável e reversível — a sua casa fica exatamente como estava se um dia precisar de remover o equipamento." },
        ].map(({ icon, title, desc }) => (
          <div class="bg-card border border-border rounded-2xl p-6 group hover:border-primary/30 transition-colors">
            <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <AnimatedIcon name={icon} class="w-5 h-5" color="hsl(var(--primary))" />
            </div>
            <h3 class="font-heading font-semibold text-foreground mb-2">{title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 md:py-20 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-8">Perguntas sobre preços de elevadores de escadas</h2>
      <div class="space-y-3">
        {[
          ["Quanto custa um elevador de escadas em Portugal?", "Um elevador de escadas custa entre 2.500€ e 8.000€, instalação incluída. Para escadas retas o preço começa nos 2.500€. Para escadas curvas, com carril fabricado à medida, o preço sobe para 4.500€–8.000€."],
          ["O preço inclui a instalação?", "Sim. Os orçamentos dos instaladores parceiros da Vida Acessível incluem sempre o equipamento, transporte, instalação completa, formação de utilização e garantia. Não há custos ocultos."],
          ["Quanto tempo demora a instalação?", "Para escadas retas, a instalação é concluída num dia. Para escadas curvas, o carril é fabricado à medida em 3–6 semanas e a instalação em casa demora 1–2 dias."],
          ["É preciso fazer obras para instalar um elevador de escadas?", "Na maioria dos casos, não. O elevador é fixado diretamente nos degraus ou na parede sem obras de construção civil. Basta ter uma tomada elétrica standard nas proximidades."],
          ["Posso instalar em escadas estreitas?", "Provavelmente sim. Existem modelos compactos para escadas com apenas 60 cm de largura útil. O assento dobra quando não está em uso, deixando passagem livre."],
          ["Existem apoios do Estado para comprar um elevador de escadas?", "Sim. O SAPA (Segurança Social) apoia a aquisição para pessoas com deficiência reconhecida. Aplica-se também IVA a 6% em habitação própria e permanente, e muitos instaladores oferecem financiamento sem juros."],
        ].map(([q, a]) => (
          <div class="faq-item border border-border rounded-xl bg-card">
            <button class="faq-btn w-full text-left px-6 py-4 font-heading font-semibold text-foreground flex justify-between items-center gap-4" aria-expanded="false">
              <span>{q}</span>
              <svg class="faq-chevron w-5 h-5 text-primary transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5 text-muted-foreground font-body text-sm leading-relaxed"><p>{a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE CTA -->
  <section class="py-14 bg-primary text-white">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center mx-auto mb-5">
        <AnimatedIcon name="euro" class="w-6 h-6" color="white" />
      </div>
      <h2 class="font-heading font-bold text-2xl md:text-3xl mb-3">Receba o preço para a sua escada específica</h2>
      <p class="font-body text-white/80 mb-8 max-w-xl mx-auto">O preço final depende da medição presencial. Peça orçamentos gratuitos a instaladores certificados — compare e escolha sem pressão.</p>
      <a href="/pedir-orcamento/" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-cta text-white font-heading font-bold rounded-full shadow-lg hover:shadow-xl transition-all group">
        Pedir orçamentos gratuitos
        <AnimatedIcon name="send" class="w-4 h-4" color="white" />
      </a>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="max-w-[880px] mx-auto px-6">
      <QuoteForm
        heading="Compare orçamentos para o seu elevador de escadas"
        subheading="Receba até 3 propostas de instaladores certificados. Sem compromisso."
      />
    </div>
  </section>

</Layout>

<script>
document.querySelectorAll('.faq-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const answer = btn.nextElementSibling as HTMLElement;
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    answer.classList.toggle('hidden');
    (btn.querySelector('.faq-chevron') as HTMLElement).style.transform = expanded ? '' : 'rotate(180deg)';
  });
});
</script>
