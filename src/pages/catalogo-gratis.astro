---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Catálogo Gratuito de Soluções de Acessibilidade — Vida Acessível"
  description="Receba gratuitamente o catálogo completo de elevadores de escadas, elevadores residenciais e plataformas elevatórias disponíveis em Portugal."
  canonical="/catalogo-gratis/"
  breadcrumbs={[{ name: 'Início', url: '/' }, { name: 'Catálogo Grátis', url: '/catalogo-gratis/' }]}
>
  <Nav />

  <section class="section-spacing">
    <div class="content-width">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Left: info -->
        <div>
          <span class="inline-block bg-primary/10 text-primary font-heading font-semibold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full mb-5">
            Gratuito
          </span>
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-foreground mb-5">
            Receba o catálogo gratuito de soluções de acessibilidade
          </h1>
          <p class="font-body text-base text-muted-foreground leading-relaxed mb-6">
            Não sabe bem por onde começar? O nosso catálogo gratuito reúne as principais soluções disponíveis no mercado português — com modelos, preços indicativos e guias de instalação.
          </p>
          <div class="space-y-3 mb-8">
            {[
              'Guia de elevadores de escadas: retos, curvos e exteriores',
              'Comparação de modelos de elevadores residenciais',
              'Plataformas elevatórias: quando e como instalar',
              'Preços indicativos e fatores de custo',
              'Apoios do Estado: IVA 6%, SAPA e financiamento',
              'Checklist de instalação',
            ].map((item) => (
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="font-body text-sm text-foreground">{item}</span>
              </div>
            ))}
          </div>
          <div
            class="rounded-2xl bg-primary/5 border border-primary/10 h-48 flex items-center justify-center"
            data-image-description="Digital catalogue cover for Vida Acessível, clean modern design, teal and white colors, showing stairlift and home elevator images, professional brochure style, WebP"
          >
            <div class="text-center p-6">
              <div class="text-5xl mb-2">📋</div>
              <p class="font-heading font-semibold text-primary text-sm">Catálogo</p>
              <p class="font-body text-xs text-muted-foreground">Imagem ilustrativa</p>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-card border border-border rounded-2xl p-6 md:p-8 shadow-sm">
          <h2 class="font-heading font-bold text-xl text-foreground mb-2">Pedir catálogo gratuito</h2>
          <p class="font-body text-sm text-muted-foreground mb-6">Preencha os seus dados e enviamos o catálogo para o seu email de imediato.</p>
          <form id="catalog-form" class="space-y-4" novalidate>
            <div>
              <label for="nome" class="block font-body text-sm font-semibold text-foreground mb-1.5">Nome *</label>
              <input type="text" id="nome" name="nome" required placeholder="O seu nome" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <div>
              <label for="email" class="block font-body text-sm font-semibold text-foreground mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required placeholder="o.seu@email.pt" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-body placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="privacidade" name="privacidade" required class="mt-0.5 h-4 w-4 rounded border-border text-primary" />
              <label for="privacidade" class="font-body text-xs text-muted-foreground leading-relaxed">
                Li e aceito a <a href="/politica-de-privacidade/" class="text-primary hover:underline">Política de Privacidade</a>. Concordo com o envio de comunicações relacionadas com o catálogo. *
              </label>
            </div>
            <div id="catalog-error" class="hidden text-sm text-destructive font-body"></div>
            <div id="catalog-success" class="hidden bg-primary/10 border border-primary/20 rounded-xl px-4 py-3 text-sm text-primary font-body font-medium"></div>
            <button type="submit" id="catalog-submit" class="w-full rounded-full bg-cta text-cta-foreground px-6 py-3.5 text-base font-heading font-bold shadow-lg hover:bg-cta/90 transition-all">
              Enviar Catálogo Gratuito
            </button>
            <p class="text-center font-body text-xs text-muted-foreground">✓ Gratuito &nbsp;·&nbsp; ✓ Sem spam &nbsp;·&nbsp; ✓ Receba de imediato</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .bg-cta { background-color: hsl(16 76% 60%); }
  .text-cta-foreground { color: hsl(0 0% 100%); }
</style>

<script>
  const form = document.getElementById('catalog-form') as HTMLFormElement;
  const submitBtn = document.getElementById('catalog-submit') as HTMLButtonElement;
  const errorEl = document.getElementById('catalog-error') as HTMLElement;
  const successEl = document.getElementById('catalog-success') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries());
    if (!data.nome || !data.email) {
      errorEl.textContent = 'Por favor preencha todos os campos obrigatórios.';
      errorEl.classList.remove('hidden'); return;
    }
    if (!data.privacidade) {
      errorEl.textContent = 'Deve aceitar a Política de Privacidade para continuar.';
      errorEl.classList.remove('hidden'); return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = 'A enviar...';
    try {
      const res = await fetch('/api/catalogo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        successEl.textContent = 'Catálogo enviado! Verifique o seu email em breve.';
        successEl.classList.remove('hidden');
        form.reset();
      } else { throw new Error(); }
    } catch {
      errorEl.textContent = 'Ocorreu um erro. Por favor tente novamente.';
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar Catálogo Gratuito';
    }
  });
</script>
