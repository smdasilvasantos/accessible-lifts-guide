---
import Layout from '../../layouts/Layout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
---

<Layout
  title="Pedir Orçamento Gratuito — Elevadores e Plataformas | Vida Acessível"
  description="Peça até 3 orçamentos gratuitos de instaladores certificados. Elevadores de escadas, residenciais e plataformas elevatórias em Portugal. Sem compromisso."
  canonical="https://vidaacessivel.pt/pedir-orcamento/"
>
  <section class="py-16 md:py-20 bg-secondary">
    <div class="max-w-[880px] mx-auto px-6 text-center">
      <h1 class="font-heading font-extrabold text-3xl md:text-5xl text-foreground leading-tight mb-4">
        Pedir Orçamento Gratuito
      </h1>
      <p class="font-body text-muted-foreground text-lg mb-4">Sem compromisso. Grátis. Resposta em 48 horas.</p>

      <!-- Trust signals -->
      <div class="flex flex-wrap justify-center gap-6 mb-10">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="font-body text-sm text-muted-foreground">Até 3 orçamentos gratuitos</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span class="font-body text-sm text-muted-foreground">Parceiros certificados</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="font-body text-sm text-muted-foreground">Resposta em 48 horas</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          <span class="font-body text-sm text-muted-foreground">Sem compromisso</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Process steps -->
  <section class="py-12 bg-background border-b border-border">
    <div class="max-w-[880px] mx-auto px-6">
      <div class="grid sm:grid-cols-3 gap-6 text-center">
        <div>
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
            <span class="font-heading font-bold text-primary">1</span>
          </div>
          <h3 class="font-heading font-semibold text-foreground mb-1">Preencha o formulário</h3>
          <p class="font-body text-sm text-muted-foreground">Diga-nos o que procura em 2 minutos</p>
        </div>
        <div>
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
            <span class="font-heading font-bold text-primary">2</span>
          </div>
          <h3 class="font-heading font-semibold text-foreground mb-1">Receba propostas</h3>
          <p class="font-body text-sm text-muted-foreground">Até 3 instaladores certificados contactam-no</p>
        </div>
        <div>
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
            <span class="font-heading font-bold text-primary">3</span>
          </div>
          <h3 class="font-heading font-semibold text-foreground mb-1">Compare e escolha</h3>
          <p class="font-body text-sm text-muted-foreground">Sem pressão. Só avança se quiser</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="max-w-[640px] mx-auto px-6">
      <QuoteForm
        heading=""
        subheading=""
      />
    </div>
  </section>

</Layout>
