---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página Não Encontrada — Vida Acessível">
  <div class="min-h-screen bg-background flex items-center justify-center px-4">
    <div class="text-center space-y-6 max-w-md">
      <h1 class="font-heading text-6xl font-extrabold text-primary">404</h1>
      <h2 class="font-heading text-2xl font-bold text-foreground">Página não encontrada</h2>
      <p class="font-body text-muted-foreground">
        A página que procura não existe ou foi movida.
      </p>
      <a
        href="/home"
        class="inline-flex items-center justify-center rounded-full bg-cta text-cta-foreground font-heading font-bold text-base h-12 px-8 shadow-lg hover:bg-cta/90 transition-all"
      >
        Voltar ao início
      </a>
    </div>
  </div>
</Layout>
