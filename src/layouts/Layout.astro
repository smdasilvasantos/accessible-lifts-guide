---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Vida Acessível | Elevadores de Escadas e Soluções de Acessibilidade em Portugal',
  description = 'Compare elevadores de escadas, elevadores residenciais e plataformas elevatórias. Receba até 3 orçamentos gratuitos de instaladores certificados em Portugal.',
  canonical,
  ogImage = 'https://www.vidaacessivel.pt/og-image.jpg',
  schema,
} = Astro.props;

const siteUrl = 'https://www.vidaacessivel.pt';
const canonicalUrl = canonical ?? siteUrl + Astro.url.pathname;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Vida Acessível",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "description": "Guia independente de acessibilidade em Portugal. Ajudamos a encontrar e comparar soluções de elevadores de escadas, elevadores residenciais e plataformas elevatórias.",
  "areaServed": { "@type": "Country", "name": "Portugal" },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "availableLanguage": "Portuguese"
  }
};

const schemaList = [
  organizationSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!DOCTYPE html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content="Vida Acessível" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD schemas -->
    {schemaList.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="font-body bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
